# Maintainer: The SculptForge contributors <https://github.com/islandmed/SculptForge>
pkgname=sculptforge
pkgver=0.11.10
pkgrel=1
pkgdesc="Free, open-source digital sculpting app with classic sculpting keys, for artists and game pipelines"
arch=('x86_64' 'aarch64')
url="https://sculptforge.app/"
license=('GPL-3.0-or-later')
depends=('sdl3' 'curl' 'zstd' 'libgcc' 'libstdc++' 'glibc' 'libglvnd' 'hicolor-icon-theme')
# libglvnd: SDL3 opens libGL at run time, so namcap can't see the need (its one warning, expected).
makedepends=('cmake')
optdepends=('ollama: local AI for the Brush Lab'
            'ffmpeg: recording demo videos (sculptforge --record)')
_imgui=1.91.9
_glm=1.0.1
source=("$pkgname-$pkgver.tar.gz::https://github.com/islandmed/SculptForge/archive/refs/tags/v$pkgver.tar.gz"
        "imgui-$_imgui.tar.gz::https://github.com/ocornut/imgui/archive/refs/tags/v$_imgui.tar.gz"
        "glm-$_glm.tar.gz::https://github.com/g-truc/glm/archive/refs/tags/$_glm.tar.gz")
sha256sums=('603ea41a112fdea8ddb1dda219eca32d723b4473da311d718e8fcb65be9588be'
            '3872a5f90df78fced023c1945f4466b654fd74573370b77b17742149763a7a7c'
            '9f3174561fd26904b23f0db5e560971cbf9b3cbda0b280f04d5c379d03bf234c')

build() {
  cmake -S "SculptForge-$pkgver" -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DSCULPTFORGE_USE_SYSTEM_SDL=ON \
    -DSCULPTFORGE_UPDATE_CHECK=OFF \
    -DSCULPTFORGE_BUILD_TESTS=OFF \
    -DSCULPTFORGE_WEBRTC=OFF \
    -DSCULPTFORGE_MOLD=OFF \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON \
    -DFETCHCONTENT_SOURCE_DIR_IMGUI="$srcdir/imgui-$_imgui" \
    -DFETCHCONTENT_SOURCE_DIR_GLM="$srcdir/glm-$_glm"
  cmake --build build
}

# No check(): the test suite needs the repository (demo assets, git history) that the tag tarball leaves out; the
# release workflow runs it on these sources and smoke-tests the packages before the tag is published.

package() {
  DESTDIR="$pkgdir" cmake --install build
}
