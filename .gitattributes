# Files that are checksummed or compared byte for byte keep their exact bytes on every platform
# (no CRLF conversion on Windows checkouts): community brushes and their index, and the website's gallery snapshot.
*.sfbrush -text
tools/brush-gallery/repo/** -text
website/gallery/** -text
tests/data/** -text
# Parallel branches all add lines at the top of these two: keep both sides instead of conflicting (the release
# coordinator checks the order of the merged result before tagging).
CHANGELOG.md merge=union
docs/guide/whats-new.md merge=union
# Compressed starter meshes: always binary, even when a file's first 8000 bytes hold no NUL (capsule.sfproj.z), so
# diffs and the push checks never read them as text.
*.sfproj.z binary
