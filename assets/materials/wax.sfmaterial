{
  "format": "sculptforge-material-recipe",
  "version": 1,
  "id": "wax",
  "name": "Wax",
  "description": "Candle wax: a warm, semi-glossy body whose roughness drifts from satin to matte, with a soft uneven build-up, rolled edges and wax pooled in the creases. SculptForge renders no translucency, so thin parts and edges get a lighter, warmer tint as a stand-in for light passing through.",
  "layers": [
    {
      "name": "Wax Body",
      "fill": {
        "material": {"channels": ["base_color", "roughness", "metallic", "height"], "color": [0.9, 0.82, 0.64], "roughness": 0.32, "metallic": 0.0, "height": 0.54},
        "mask": [{"kind": "fill", "value": 1.0}]
      }
    },
    {
      "name": "Wax Roughness Variation",
      "fill": {
        "material": {"channels": ["roughness"], "roughness": 0.7},
        "mask": [{"kind": "noise", "scale": 0.09, "octaves": 3, "seed": 17, "contrast": 1.4},
                 {"kind": "levels", "in_low": 0.4, "in_high": 0.75}]
      }
    },
    {
      "name": "Rolled Edges",
      "fill": {
        "material": {"channels": ["roughness", "height"], "roughness": 0.22, "height": 0.66},
        "mask": [{"kind": "generator", "generator": "edge_wear", "level": 0.5, "softness": 0.6, "breakup": 0.3, "scale": 0.04, "seed": 8},
                 {"kind": "blur", "radius": 4}]
      }
    },
    {
      "name": "Pooled Wax",
      "fill": {
        "material": {"channels": ["roughness", "height"], "roughness": 0.2, "height": 0.74},
        "mask": [{"kind": "generator", "generator": "dirt", "level": 0.5, "softness": 0.6, "breakup": 0.5, "scale": 0.05, "seed": 6},
                 {"kind": "blur", "radius": 5}]
      }
    },
    {
      "name": "Soft Build-up",
      "fill": {
        "material": {"channels": ["roughness", "height"], "roughness": 0.28, "height": 0.62},
        "mask": [{"kind": "noise", "scale": 0.22, "octaves": 3, "seed": 29, "contrast": 1.1},
                 {"kind": "levels", "in_low": 0.35, "in_high": 0.9},
                 {"kind": "blur", "radius": 8}]
      }
    },
    {
      "name": "Light Wrap Tint",
      "fill": {
        "material": {"channels": ["base_color"], "color": [1.0, 0.84, 0.52]},
        "mask": [{"kind": "generator", "generator": "edge_wear", "level": 0.55, "softness": 0.6, "breakup": 0.3, "scale": 0.04, "seed": 12},
                 {"kind": "generator", "generator": "thickness", "blend": "add", "level": 0.5, "softness": 0.5, "breakup": 0.2, "scale": 0.05, "seed": 13},
                 {"kind": "levels", "out_high": 0.8}]
      }
    }
  ]
}
