# embed_featured(<output.cpp> <dir>)
# Embeds the Welcome dialog's featured creator videos (assets/featured: featured.json and its thumbnails *.jpg, *.png) in the
# app, so nothing is fetched at run time. Generates
#   namespace sf::featured_data { struct File { const char* path; const unsigned char* data; unsigned long long size; };
#                                 extern const File kFiles[]; extern const int kFileCount; }
function(embed_featured output dir)
  file(GLOB files CONFIGURE_DEPENDS RELATIVE ${dir} ${dir}/*.json ${dir}/*.jpg ${dir}/*.png)
  list(SORT files)
  set(content "// Generated by cmake/EmbedFeatured.cmake from assets/featured - do not edit.\nnamespace sf::featured_data {\n")
  string(APPEND content "struct File { const char* path; const unsigned char* data; unsigned long long size; };\n")
  set(table "")
  set(index 0)
  foreach(rel ${files})
    set(file ${dir}/${rel})
    set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${file})
    file(READ ${file} hex HEX)
    file(SIZE ${file} size)
    string(REGEX REPLACE "([0-9a-f][0-9a-f])" "0x\\1," bytes "${hex}")
    string(REGEX REPLACE "((0x..,){32})" "\\1\n" bytes "${bytes}")
    string(APPEND content "static const unsigned char f${index}[] = {\n${bytes}0};\n")
    string(APPEND table "  {\"${rel}\", f${index}, ${size}ull},\n")
    math(EXPR index "${index} + 1")
  endforeach()
  string(APPEND content "extern const File kFiles[] = {\n${table}  {nullptr, nullptr, 0}};\n")
  string(APPEND content "extern const int kFileCount = ${index};\n} // namespace sf::featured_data\n")
  file(WRITE ${output}.tmp "${content}")
  file(COPY_FILE ${output}.tmp ${output} ONLY_IF_DIFFERENT)
endfunction()
