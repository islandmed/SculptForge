# Writes the commit stamp the app shows ("0.13.14 dev 1a2b3c4") and proof mode records, as a tiny source file.
# Run on EVERY build (a custom target in CMakeLists.txt, cmake -P): the file is rewritten only when the commit or the
# dirty flag changed, so a build with nothing new stays a no-op and just that one translation unit recompiles after a commit.
#   -DSF_SRC=<source dir> -DSF_OUT=<generated .cpp> -DSF_DEV=ON|OFF (OFF: a release or CI build, no "dev" stamp)
find_package(Git QUIET)
set(commit "")
set(dirty 0)
if(GIT_FOUND AND EXISTS "${SF_SRC}/.git") # (.git is a file in a worktree; a tarball has none: AUR, brew, Flatpak)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD WORKING_DIRECTORY "${SF_SRC}"
                  OUTPUT_VARIABLE commit OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    set(commit "")
  else()
    execute_process(COMMAND ${GIT_EXECUTABLE} diff-index --quiet HEAD -- WORKING_DIRECTORY "${SF_SRC}"
                    RESULT_VARIABLE drc ERROR_QUIET)
    if(NOT drc EQUAL 0)
      set(dirty 1)
    endif()
  endif()
endif()
set(dev "")
if(SF_DEV AND NOT SF_DEV STREQUAL "OFF")
  set(dev "${commit}")
endif()
set(content "// Generated by cmake/BuildStamp.cmake on every build; rewritten only when the commit changes. Do not edit.
#include \"core/BuildStamp.h\"
namespace sf {
const char* buildCommit() { return \"${commit}\"; }
const char* devCommit() { return \"${dev}\"; }
bool buildDirty() { return ${dirty} != 0; }
} // namespace sf
")
set(old "")
if(EXISTS "${SF_OUT}")
  file(READ "${SF_OUT}" old)
endif()
if(NOT old STREQUAL content)
  file(WRITE "${SF_OUT}" "${content}")
endif()
