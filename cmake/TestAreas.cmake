# Test areas (tests/areas.map, docs/testing-flow.md "Areas"): every ctest entry gets exactly one label area_<name>,
# and the cross-area set [smoke] also the label `smoke`. `ctest -L area_cloth` runs one area, `ctest -L smoke` the quick set.
# <build>/test-areas.tsv lists "name<TAB>area<TAB>smoke(0|1)" for tools/test/affected.py and the test_areas check;
# an entry the map doesn't cover is written with area `-` (that check fails, the build doesn't).

# A glob with `*` only -> an anchored regex.
function(sf_glob_to_regex glob out)
  string(REGEX REPLACE "([][+.?()^$|\\{}])" "\\\\\\1" r "${glob}")
  string(REPLACE "*" ".*" r "${r}")
  set(${out} "^${r}$" PARENT_SCOPE)
endfunction()

function(sculptforge_label_test_areas)
  file(STRINGS ${CMAKE_CURRENT_SOURCE_DIR}/tests/areas.map lines)
  set(section "")
  set(rules "")
  set(smoke "")
  foreach(line IN LISTS lines)
    string(REGEX REPLACE "#.*$" "" line "${line}")
    string(STRIP "${line}" line)
    if(line STREQUAL "")
      continue()
    endif()
    if(line MATCHES "^\\[(.*)\\]$")
      set(section "${CMAKE_MATCH_1}")
    elseif(section STREQUAL "tests" AND line MATCHES "^([^ \t]+)[ \t]+([a-z]+)$")
      sf_glob_to_regex("${CMAKE_MATCH_1}" re)
      list(APPEND rules "${re}|${CMAKE_MATCH_2}")
    elseif(section STREQUAL "smoke")
      list(APPEND smoke "${line}")
    endif()
  endforeach()
  get_directory_property(all_tests TESTS)
  set(tsv "")
  foreach(t IN LISTS all_tests)
    set(area "-")
    foreach(rule IN LISTS rules)
      string(FIND "${rule}" "|" bar REVERSE)
      string(SUBSTRING "${rule}" 0 ${bar} re)
      if(t MATCHES "${re}")
        math(EXPR from "${bar} + 1")
        string(SUBSTRING "${rule}" ${from} -1 area)
        break()
      endif()
    endforeach()
    set(is_smoke 0)
    if(t IN_LIST smoke)
      set(is_smoke 1)
    endif()
    set(labels "")
    if(NOT area STREQUAL "-")
      list(APPEND labels "area_${area}")
    endif()
    if(is_smoke)
      list(APPEND labels smoke)
    endif()
    if(labels)
      set_property(TEST ${t} APPEND PROPERTY LABELS ${labels})
    endif()
    string(APPEND tsv "${t}\t${area}\t${is_smoke}\n")
  endforeach()
  file(WRITE ${CMAKE_CURRENT_BINARY_DIR}/test-areas.tsv "${tsv}")
  set_property(DIRECTORY APPEND PROPERTY CMAKE_CONFIGURE_DEPENDS ${CMAKE_CURRENT_SOURCE_DIR}/tests/areas.map)
endfunction()
