# Sandboxed plugins (core/Plugin.h, docs/design/plugins.md): the wasmtime C API, linked statically from the Bytecode
# Alliance's release archives, pinned by SHA-256 in cmake/Fetch.cmake (SF_PIN_wasmtime_<platform>). Update the pins
# every release (docs/releasing.md). Without a pin for this platform, or with SCULPTFORGE_PLUGINS=OFF, the build has
# no plugin runtime: packs holding plugins still install, and running one says the build can't.
# Offline packagers (Flatpak, AUR) pass FETCHCONTENT_SOURCE_DIR_WASMTIME_<PLATFORM>, or the plugins are left out.
option(SCULPTFORGE_PLUGINS "Sandboxed WebAssembly plugins (wasmtime)" ON)
set(SF_WASMTIME_LIB "")

if(SCULPTFORGE_PLUGINS)
  set(_sf_wt "")
  if(APPLE)
    set(_arches "${CMAKE_OSX_ARCHITECTURES}")
    if(NOT _arches)
      set(_arches "${CMAKE_HOST_SYSTEM_PROCESSOR}")
    endif()
    foreach(a ${_arches})
      if(a MATCHES "^(arm64|aarch64)$")
        list(APPEND _sf_wt wasmtime_macos_aarch64)
      elseif(a STREQUAL "x86_64")
        list(APPEND _sf_wt wasmtime_macos_x86_64)
      endif()
    endforeach()
  elseif(WIN32 AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8 AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|arm")
    set(_sf_wt wasmtime_windows_x86_64)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64)$")
    set(_sf_wt wasmtime_linux_x86_64)
  elseif(CMAKE_SYSTEM_NAME STREQUAL "Linux" AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(aarch64|arm64)$")
    set(_sf_wt wasmtime_linux_aarch64)
  endif()
  set(_libs "")
  set(_inc "")
  foreach(n ${_sf_wt})
    string(TOUPPER "${n}" up)
    if(FETCHCONTENT_FULLY_DISCONNECTED AND NOT FETCHCONTENT_SOURCE_DIR_${up})
      set(_libs "")
      message(STATUS "Plugins: off (offline build without FETCHCONTENT_SOURCE_DIR_${up})")
      break()
    endif()
    sf_fetch_declare(${n} DOWNLOAD_EXTRACT_TIMESTAMP TRUE)
    FetchContent_MakeAvailable(${n}) # an archive without a CMakeLists.txt: extracted only
    if(WIN32)
      list(APPEND _libs ${${n}_SOURCE_DIR}/lib/wasmtime.lib)
    else()
      list(APPEND _libs ${${n}_SOURCE_DIR}/lib/libwasmtime.a)
    endif()
    set(_inc ${${n}_SOURCE_DIR}/include)
  endforeach()
  list(LENGTH _libs _n)
  if(_n GREATER 1)
    # A universal macOS build: one fat archive from the two.
    set(SF_WASMTIME_LIB ${CMAKE_BINARY_DIR}/wasmtime-universal/libwasmtime.a)
    if(NOT EXISTS ${SF_WASMTIME_LIB})
      file(MAKE_DIRECTORY ${CMAKE_BINARY_DIR}/wasmtime-universal)
      execute_process(COMMAND lipo -create ${_libs} -output ${SF_WASMTIME_LIB} RESULT_VARIABLE rc)
      if(NOT rc EQUAL 0)
        message(FATAL_ERROR "lipo could not join the wasmtime archives")
      endif()
    endif()
  elseif(_n EQUAL 1)
    set(SF_WASMTIME_LIB ${_libs})
  elseif(NOT _sf_wt)
    message(STATUS "Plugins: off (no wasmtime build for ${CMAKE_SYSTEM_NAME} ${CMAKE_SYSTEM_PROCESSOR})")
  endif()
endif()

if(SF_WASMTIME_LIB)
  message(STATUS "Plugins: wasmtime ${SF_WASMTIME_VERSION}")
  add_library(sf_wasmtime STATIC IMPORTED GLOBAL)
  set_target_properties(sf_wasmtime PROPERTIES IMPORTED_LOCATION ${SF_WASMTIME_LIB} INTERFACE_INCLUDE_DIRECTORIES ${_inc})
  # Linked statically: no dllimport on Windows.
  set_property(TARGET sf_wasmtime PROPERTY INTERFACE_COMPILE_DEFINITIONS WASM_API_EXTERN= WASI_API_EXTERN= SF_HAVE_WASMTIME=1)
  if(WIN32)
    set_property(TARGET sf_wasmtime PROPERTY INTERFACE_LINK_LIBRARIES ws2_32 advapi32 userenv ntdll shell32 ole32 bcrypt synchronization)
  elseif(APPLE)
    set_property(TARGET sf_wasmtime PROPERTY INTERFACE_LINK_LIBRARIES "-framework CoreFoundation")
  else()
    set_property(TARGET sf_wasmtime PROPERTY INTERFACE_LINK_LIBRARIES Threads::Threads ${CMAKE_DL_LIBS} m)
  endif()
endif()
