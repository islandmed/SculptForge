<?xml version="1.0" encoding="utf-8"?>
<!-- No permissions: projects live in the app's own storage, other files come through the system's document picker. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    android:installLocation="auto">

    <uses-feature android:glEsVersion="0x00030002" android:required="true" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <uses-feature android:name="android.hardware.type.pc" android:required="false" />
    <!-- Chromebooks and keyboard + mouse setups (Samsung DeX, tablets with a keyboard cover): no touch needed. -->
    <uses-feature android:name="android.hardware.faketouch" android:required="false" />

    <application
        android:label="@string/app_name"
        android:icon="@mipmap/ic_launcher"
        android:allowBackup="true"
        android:hardwareAccelerated="true"
        android:resizeableActivity="true"
        android:theme="@android:style/Theme.Black.NoTitleBar">
        <activity
            android:name="SculptForgeActivity"
            android:label="@string/app_name"
            android:exported="true"
            android:alwaysRetainTaskState="true"
            android:launchMode="singleInstance"
            android:configChanges="layoutDirection|locale|grammaticalGender|fontScale|fontWeightAdjustment|orientation|uiMode|screenLayout|screenSize|smallestScreenSize|density|keyboard|keyboardHidden|navigation"
            android:preferMinimalPostProcessing="true">
            <!-- Free-form windows (ChromeOS, Samsung DeX, split screen): start at a useful size, never smaller. -->
            <layout android:defaultWidth="1280dp" android:defaultHeight="800dp"
                android:minWidth="600dp" android:minHeight="400dp" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Samsung DeX: moving between the tablet and a monitor changes density; the app keeps running (configChanges). -->
        <meta-data android:name="com.samsung.android.keepalive.density" android:value="true" />
    </application>
</manifest>
