# Undo / redo of strokes on a dense mesh, played in real time (sculptforge --benchmark-script; #181): the CSV's frame_ms
# at each key is the undo's cost with the GPU upload.
run new_sphere triangles=2000000
camera 0 0
wait 2
stroke 0.3 0.4 0.7 0.6 0.8
wait 0.7
stroke 0.3 0.6 0.7 0.4 0.8
wait 0.7
stroke 0.4 0.3 0.6 0.7 0.8
wait 0.7
key ctrl+z
wait 0.8
key ctrl+z
wait 0.8
key ctrl+shift+z
wait 0.8
key ctrl+shift+z
wait 0.8
key ctrl+z
wait 0.8
key ctrl+z
wait 0.8
key ctrl+z
wait 0.8
