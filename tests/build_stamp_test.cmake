# ctest build_stamp: cmake/BuildStamp.cmake follows the commit at BUILD time. In a scratch git repo: stamp, commit, stamp again
# (the file shows the new commit), stamp with nothing new (the file is not touched, so a no-op build stays a no-op), a tracked
# edit (dirty flag), SF_DEV=OFF (a release build: no dev stamp) and a tree without .git (a tarball: empty commit, exit 0). Run: cmake -DSF_SCRIPT=... -DSF_WORK=... -P this file.
find_package(Git QUIET)
if(NOT GIT_FOUND)
  message(STATUS "build_stamp: no git, skipped")
  return()
endif()
set(repo "${SF_WORK}/repo")
file(REMOVE_RECURSE "${SF_WORK}")
file(MAKE_DIRECTORY "${repo}")
function(git)
  execute_process(COMMAND ${GIT_EXECUTABLE} -c user.name=t -c user.email=t@example.org -c commit.gpgsign=false ${ARGN}
                  WORKING_DIRECTORY "${repo}" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "git ${ARGN}: ${err}")
  endif()
endfunction()
function(head out)
  execute_process(COMMAND ${GIT_EXECUTABLE} rev-parse --short HEAD WORKING_DIRECTORY "${repo}" OUTPUT_VARIABLE h OUTPUT_STRIP_TRAILING_WHITESPACE)
  set(${out} "${h}" PARENT_SCOPE)
endfunction()
function(stamp dev)
  execute_process(COMMAND ${CMAKE_COMMAND} -DSF_SRC=${repo} -DSF_OUT=${SF_WORK}/BuildStamp.cpp -DSF_DEV=${dev} -P ${SF_SCRIPT}
                  RESULT_VARIABLE rc)
  if(NOT rc EQUAL 0)
    message(FATAL_ERROR "BuildStamp.cmake failed")
  endif()
endfunction()
function(expect_in text)
  file(READ ${SF_WORK}/BuildStamp.cpp got)
  string(FIND "${got}" "${text}" at)
  if(at LESS 0)
    message(FATAL_ERROR "expected '${text}' in:\n${got}")
  endif()
endfunction()

git(init -q)
file(WRITE "${repo}/a.txt" "one\n")
git(add a.txt)
git(commit -q -m one)
head(c1)
stamp(ON)
expect_in("devCommit() { return \"${c1}\"; }")
expect_in("buildDirty() { return 0 != 0; }")

file(WRITE "${repo}/a.txt" "two\n")
git(commit -q -a -m two)
head(c2)
if(c1 STREQUAL c2)
  message(FATAL_ERROR "the two commits share a short sha")
endif()
stamp(ON)
expect_in("buildCommit() { return \"${c2}\"; }")

file(TIMESTAMP "${SF_WORK}/BuildStamp.cpp" t1 "%s")
execute_process(COMMAND ${CMAKE_COMMAND} -E sleep 1.1)
stamp(ON)
file(TIMESTAMP "${SF_WORK}/BuildStamp.cpp" t2 "%s")
if(NOT t1 STREQUAL t2)
  message(FATAL_ERROR "nothing changed but the stamp file was rewritten (${t1} -> ${t2})")
endif()

file(WRITE "${repo}/a.txt" "three\n")
stamp(ON)
expect_in("buildDirty() { return 1 != 0; }")

stamp(OFF)
expect_in("devCommit() { return \"\"; }")
expect_in("buildCommit() { return \"${c2}\"; }")
# A tarball (AUR, brew, Flatpak: no .git) still stamps: the script exits 0 and the commit is empty, dev stamp included.
set(tarball "${SF_WORK}/tarball")
file(MAKE_DIRECTORY "${tarball}")
file(WRITE "${tarball}/a.txt" "one\n")
file(REMOVE "${SF_WORK}/BuildStamp.cpp")
execute_process(COMMAND ${CMAKE_COMMAND} -DSF_SRC=${tarball} -DSF_OUT=${SF_WORK}/BuildStamp.cpp -DSF_DEV=ON -P ${SF_SCRIPT}
                RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "BuildStamp.cmake failed without a .git")
endif()
expect_in("buildCommit() { return \"\"; }")
expect_in("devCommit() { return \"\"; }")
message(STATUS "build_stamp: ok")
