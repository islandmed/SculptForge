# Generate 3D's defaults (0.10.9): Hunyuan3D 2.1 on Hugging Face (no token needed); the sculpting base is Voxel Remesh
# then Quad Remesh (0.12: Then Quad Remesh off = the voxel surface alone), with a hidden high-detail copy; 3 candidates.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar
drop ../../assets/demo/teddy-sketch.png
wait_for "Generate 3D" 5
expect_text Hunyuan3D 2.1 (Tencent) - free, no token
expect_text About 32768 quads, then 1 subdivision level
shot generate-defaults
expect_value generate_candidates == 0
expect "Generate 3D/Keep a high-detail copy (hidden)"
click "Generate 3D/Then Quad Remesh"
wait 0.2
expect_no_text About 32768 quads
shot generate-voxel

# The token the TRELLIS.2 fallback message points to: Preferences > AI.
click "Preferences##palette.preferences"
click "AI##preferences.ai"
wait 0.2
expect_text Hugging Face token
shot preferences-ai
