# Tool > Reshape (tidied for foirgairwolf on Discord): Size, then the Stack, the one home of the whole-Part operations;
# Smooth, Relax, Polish and Balloon are its Surface steps, no longer duplicate sliders. Mirror is in Geometry > Symmetry.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=4
run deform_balloon amount=-40
# The old actions still run (menus, keys, search: here the command palette), at amount 50, one undo step each. Before
# the Tool palette opens: below 1280 px it is a drop-down the command palette closes.
snapshot
key f3
type "##Command palette" balloon
key enter
expect_status "Balloon 50"
expect_value moved_out > 0
key ctrl+z
expect_value moved == 0

# Masked all over: nothing moves, and the status says why.
run mask_all
key f3
type "##Command palette" balloon
key enter
expect_status "everything masked"
expect_value moved == 0
run mask_clear

click "Tool##palette.tool"
click "Reshape##tool.deformation"
expect_not "Reshape/Mirror"
expect "Size/##deform_size_x"
shot reshape
expect_not "##deform_balloon_amount"
expect_not "Smooth keeps volume##deformation.smooth_volume"

# Surface steps on the Stack: each moves the Part; Smooth has Keep volume; Reset takes it back.
click "##deform_stack_add"
click "Stack/Balloon##deform_add_Balloon"
expect_status "Deform stack (1 step)"
expect_value moved_out > 0
shot balloon
click "Stack/Reset"
expect_value moved == 0
click "##deform_stack_add"
click "Stack/Smooth##deform_add_Smooth"
expect_value moved > 0
expect "Stack/Keep volume##deform_step_volume"
click "Stack/Keep volume##deform_step_volume"
expect_value moved > 0
click "Stack/Reset"
click "##deform_stack_add"
click "Stack/Polish##deform_add_Polish"
expect_status "Deform stack (1 step)"
click "Stack/Reset"
click "##deform_stack_add"
click "Stack/Relax##deform_add_Relax"
expect_value moved > 0
click "Stack/Reset"
expect_value moved == 0

# The stack (docs/design/deform-panel.md): add steps, the preview follows, Apply is one undo step, Reset takes it back.
expect "##deform_stack_add"
expect_text No steps yet
click "##deform_stack_add"
click "Stack/Bend##deform_add_Bend"
expect_status "Deform stack (1 step)"
expect_value moved > 0
expect "##deform_step_amount"
expect "##deform_step_direction"
expect "Stack/X"
shot stack-bend
click "##deform_stack_add"
click "Stack/Twist##deform_add_Twist"
expect_status "Deform stack (2 steps)"
click "Stack/Repeat"
expect_status "Deform stack (3 steps)"
click "Stack/Remove"
expect_status "Deform stack (2 steps)"
# Reset: back where it was, the list empty.
click "Stack/Reset"
expect_value moved == 0
expect_text No steps yet
# Apply keeps the preview; one undo takes the whole stack back.
click "##deform_stack_add"
click "Stack/Taper##deform_add_Taper"
click "##deform_stack_add"
click "Stack/Round##deform_add_Round"
click "Stack/Apply"
expect_value moved > 0
expect_text No steps yet
key ctrl+z
expect_value moved == 0

# Size: the Part's dimensions in scene units; typing one resizes it (Uniform: in proportion), one undo step.
expect "Size/##deform_size_x"
expect "Size/Uniform##deform_size_uniform"
run deform_size uniform=3
expect_status "Size 3"
key ctrl+z
expect_value moved == 0
