# Micro-displacement levels (Tool > Geometry > Micro): Add Micro stores the surface above the highest level
# as displacement grids, the viewport draws it, Standard and Move sculpt it, undo steps back, Delete Micro removes it.
run new_sphere subdivisions=5
orbit 30 -15
click "Geometry##tool.geometry"
expect "Geometry/Add Micro"
click "Geometry/Add Micro"
expect_status "Added micro"
expect "Geometry/Bake Micro"
expect_text "Micro 4"
# The title bar counts the micro triangles beside the triangles (#125).
expect_text "20.5k + 5.24M micro"

# Wire on a micro level shows the base's wireframe on the micro surface (#128).
shot micro-plain
remember edges@0.4,0.35,0.6,0.65 plain
click "Wire##view.wire"
expect_value wireframe == 1
shot micro-wire
expect_value edges@0.4,0.35,0.6,0.65 > $plain*1.5
click "Wire##view.wire"
expect_value wireframe == 0

run micro_noise amplitude=0.003 scale=40
shot micro-noise

# Standard (B S T) on the micro surface.
key b
key s
key t
stroke 0.3 0.4 0.7 0.45
stroke 0.35 0.55 0.65 0.6
shot micro-strokes
key ctrl+z
key ctrl+z
expect_status "Undo"

# Delete Micro takes it away; undo brings it back.
click "Geometry/Delete Micro"
expect "Geometry/Add Micro"
key ctrl+z
expect "Geometry/Bake Micro"
