# Dragging the Size slider (top shelf, Draw palette, quick menu) shows the brush ring on the canvas at the new size,
# live (ABHITAR on Discord): where the cursor last lay on the model, else the canvas centre; it fades out about half
# a second after the slider is let go.
run ui_look look=forge layout=sculptforge
run new_sphere subdivisions=3
key f
camera 0 0
mouse_move 0.5 0.5
wait 0.2
expect_value size_slider_ring == 0
remember draw_size s0

drag_item "##drawsize" 60 0 0.4 keep
expect_value size_slider_ring == 1
expect_value draw_size > $s0
shot dragging
release
wait 0.15
expect_value size_slider_ring > 0
expect_value size_slider_ring < 1
wait 0.6
expect_value size_slider_ring == 0

# Smaller: the ring follows the slider down.
drag_item "##drawsize" -90 0 0.4 keep
expect_value size_slider_ring == 1
expect_value draw_size < $s0
shot smaller
release
wait 0.8
expect_value size_slider_ring == 0
