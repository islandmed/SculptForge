# QRemesh Guides (ZBrush's ZRemesher Guides brush): draw a loop round an "eye" on a sphere with X symmetry (it is
# mirrored), an open curve across the middle (its own mirror image, so kept once), Delete Last, Alt+click a curve to
# delete it, then QRemesh follows the loops: an edge loop round each eye. Guides are saved with the project.
run new_sphere subdivisions=6
click "Geometry##tool.geometry"
expect "QRemesh/Quad Remesh Guides"
expect_value qremesh_guides == 0

# Ctrl-hover help on the new controls.
hold ctrl
hover "QRemesh/Quad Remesh Guides"
expect_help "ZRemesher Guides"
hover "QRemesh/Delete Last"
expect_help "last Quad Remesh guide"
hover "QRemesh/Clear"
expect_help "every Quad Remesh guide"
hover "QRemesh/##qcurves"
expect_help "six quads"
hold none

# Pick the brush and draw a loop round the right eye: X symmetry mirrors it onto the left one.
click "QRemesh/Quad Remesh Guides"
expect_value guides_mode == 1
expect_status "Quad Remesh Guides"
snapshot
drag_path 0.790 0.380 0.785 0.414 0.769 0.445 0.745 0.469 0.714 0.485 0.680 0.490 0.646 0.485 0.615 0.469 0.591 0.445 0.575 0.414 0.570 0.380 0.575 0.346 0.591 0.315 0.615 0.291 0.646 0.275 0.680 0.270 0.714 0.275 0.745 0.291 0.769 0.315 0.785 0.346 0.790 0.380
expect_value qremesh_guides == 2
expect_value qremesh_guide_loops == 2
expect_status "a loop, mirrored"
expect_value moved == 0
expect_text "2 curves (2 loops)"
shot guides-drawn

# An open curve across the middle is its own mirror image: one curve.
drag_path 0.3 0.72 0.4 0.76 0.5 0.77 0.6 0.76 0.7 0.72
expect_value qremesh_guides == 3
expect_value qremesh_guide_loops == 2
click "QRemesh/Delete Last"
expect_value qremesh_guides == 2

# Alt+click on a curve deletes it with its mirror; the background still navigates.
hold alt
click_subtool Sphere 0.79 0.38
hold none
expect_value qremesh_guides == 0
expect_status "deleted"
drag_path 0.760 0.400 0.755 0.431 0.741 0.459 0.719 0.481 0.691 0.495 0.660 0.500 0.629 0.495 0.601 0.481 0.579 0.459 0.565 0.431 0.560 0.400 0.565 0.369 0.579 0.341 0.601 0.319 0.629 0.305 0.660 0.300 0.691 0.305 0.719 0.319 0.741 0.341 0.755 0.369 0.760 0.400
expect_value qremesh_guides == 2
remember camera_yaw yaw
orbit 60 0
expect_value camera_yaw != $yaw
expect_value qremesh_guides == 2

# QRemesh follows them: a loop round each eye.
drag_item "QRemesh/##qtarget" -16 0
click "QRemesh/Quad Remesh"
wait_idle 120
expect_status "100% quads"
expect_status "followed 2 guides"
expect_value quad_percent == 100
expect_value qremesh_guides == 2
key ctrl+z
expect_value quads == 0
key ctrl+shift+z
orbit -60 0
click "Wire##view.polyf"
shot guides-qremesh-polyf
click "Wire##view.polyf"

# Picking a brush leaves the guides brush; the guides stay (shown fainter).
click "Clay##brush.clay"
expect_value guides_mode == 0
expect_value qremesh_guides == 2

# The F3 command palette finds the brush; picking the brush that was active before leaves it again.
key f3
type "##Command palette" "quad remesh guides"
expect_text "Quad Remesh Guides"
key enter
expect_value guides_mode == 1
expect_text "Quad Remesh Guides"
click "Clay##brush.clay"
expect_value guides_mode == 0
# Clear deletes every curve.
click "QRemesh/Clear"
expect_value qremesh_guides == 0
expect_text "no curves"
