# Supporting SculptForge: Help > Support SculptForge..., the first-run welcome and the supporters in Help > About.
# Every one only asks for sculptforge.app/support.html (UI tests never start a browser); nothing else changes.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=3
expect_value welcome_open == 0
expect_value support_requests == 0

# Help > Support SculptForge...
click "Help##palette.help"
expect "Support SculptForge...##help.support"
click "Support SculptForge...##help.support"
expect_value support_requests == 1
expect_status sculptforge.app/support.html

# Help > Join the Discord... (the official community invite; nothing else changes).
click "Help##palette.help"
expect "Join the Discord...##help.discord"
click "Join the Discord...##help.discord"
expect_value discord_requests == 1
expect_status https://discord.gg/gWrYkEmQhH
expect_value support_requests == 1

# The welcome (shown by itself on the first start; Help > Welcome from the command palette here).
key f3
type "##Command palette" "welcome"
key enter
expect_value welcome_open == 1
expect_text "SculptForge is free. A membership adds betas and early builds, a vote on what we build next, Member Requests (ask for a brush or an alpha) and your name in the credits."
shot welcome
# Its Support button shows the membership card (each tier a click from its checkout) over the welcome.
click "Support SculptForge##welcome"
expect_value support_card_open == 1
wait 0.4
expect_value support_requests == 1
key Escape
wait 0.4
expect_value support_card_open == 0
click "Join the community on Discord##welcome"
expect_value discord_requests == 2
expect_value welcome_open == 1
click "Close##welcome"
expect_value welcome_open == 0

# Help > About: what artists say, the Founding Members and the supporters (docs/testimonials-app.json,
# docs/supporters.txt, website/founding.json: compiled in),
# checked without naming anyone, so a new credit doesn't break the test.
click "Help##palette.help"
click "About SculptForge##help.about"
expect_text "What artists say"
expect_text "Founding Members"
expect_text "Supporters"
expect_text "Thank you to everyone who supports SculptForge"
expect_text "bug-fix and security releases go out to everyone the same day"
shot about_supporters
click "Support SculptForge##about"
expect_value support_requests == 2
