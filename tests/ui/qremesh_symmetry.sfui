# QRemesh symmetry and pieces: Symmetry is on by default and mirrors about the model's own plane, so a sculpt
# moved away from the world centre still comes out mirror-symmetric (about x = 2.5 here); a model that isn't
# symmetric is remeshed whole (the status line says so) and a small separate piece is kept, not dropped.
run new_sphere subdivisions=5
run stroke points="-0.5,0.35,2 0,0.5,2 0.5,0.35,2" brush=Standard radius=0.16 strength=1
run stroke points="-0.45,-0.35,2 0.45,-0.35,2" brush=Crease radius=0.12 strength=1
run transform translate=2.5,0,0 masked=false
expect_value center_x > 2.45
expect_value center_x < 2.55
click "Geometry##tool.geometry"
expect "QRemesh/Symmetry"

# Ctrl-hover help explains the plane.
hold ctrl
hover "QRemesh/Symmetry"
expect_help "model's own"
hold none

# Off-centre: mirrored about the model's middle, not the world's.
drag_item "QRemesh/##qtarget" -20 0
click "QRemesh/Quad Remesh"
wait_idle 120
expect_status "mirrored across X = 2.5"
expect_value quad_percent == 100
expect_value center_x > 2.45
expect_value center_x < 2.55
click "Frame##view.frame"
click "Wire##view.polyf"
shot offcentre-symmetry-polyf
click "Wire##view.polyf"

# A small separate piece beside it: not symmetric any more, so no mirroring; both pieces come out as quads.
run subtool_append type=sphere size=0.12
run subtool_merge_visible
remember triangles merged_tris
click "QRemesh/Quad Remesh"
wait_idle 120
expect_status "Symmetry off"
expect_value quad_percent == 100
click "Frame##view.frame"
click "Wire##view.polyf"
shot small-piece-kept-polyf
