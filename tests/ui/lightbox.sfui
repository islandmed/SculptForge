# LightBox (comma key): tabs, history, loading models, appending SubTools, materials,
# brushes, QuickSave; then the ZBrush-style pickers: the brush pop-up (B, type letters,
# press the orange key), the material pop-up (M) and Draw Size / Z Intensity at the cursor (S / U).
run new_plane resolution=8
expect_value triangles == 128
expect_value lightbox_open == 0   # (the window; "LightBox" is also the top-shelf button)

key ,
expect_value lightbox_open == 1
click "Library/Tool"
expect "Library/Sphere"
expect "Library/Cube"
expect "Library/Built-in"
wait_idle 60
shot lightbox-tool

# The header links to the issue forms ("Fixes & suggestions"; tests never open a browser).
click "Library/###Fixes & suggestions"
expect_status Submit a request for a fix or a suggestion

# Double-click a model to open it (replaces the scene), Shift+double-click to append it as a SubTool.
double_click "Library/Sphere"
expect_value triangles > 128
expect_value subtools == 1
hold shift
double_click "Library/Cube"
hold none
expect_value subtools == 2
expect_status Appended Part

# A tile dragged out of the strip onto the canvas loads like a double-click (the Cube tile).
drag_item "Library/Cube" 500 300
expect_status Created cube
expect_value subtools == 1

# Folders: Built-in holds the bundled demo files; ".." and Back return to the tab's root.
double_click "Library/Built-in"
wait_idle 30
expect "Library/lion-head"
expect_not "Library/Sphere"
double_click "Library/.."
expect "Library/Sphere"
double_click "Library/User"
wait_idle 30
expect "Library/.."
click "Library/###Back"
expect "Library/Sphere"

# Materials and brushes load with a double-click too.
click "Library/Material"
expect "Library/Chrome"
double_click "Library/Chrome"
expect_status Material: Chrome
click "Library/Brush"
expect "Library/Sharp Crease"
double_click "Library/Sharp Crease"
expect_status Brush: Sharp Crease
wait_idle 60
shot lightbox-brush

# Drag sideways to scrub the strip: brushes far to the right come into view.
expect_not "Library/Skin Pores"
drag_item "Library/Inflate" -700 0
drag_item "Library/Nudge" -700 0
drag_item "Library/Elastic Tendril" -700 0
expect "Library/Skin Pores"
expect_status Brush: Sharp Crease

# More rows, then back through the history to the Material tab.
click "Library/3"
wait_idle 60
shot lightbox-3-rows
click "Library/1"
click "Library/###Back"
expect "Library/Chrome"

# QuickSave: a timestamped copy in the library's QuickSave folder, listed newest first.
click "Library/Snapshots"
expect_text Save Snapshot keeps timestamped copies
click "Library/###QuickSave now"
expect_status Saved Snapshot
wait 6
wait_idle 30
expect_no_text Save Snapshot keeps timestamped copies
shot lightbox-quicksave

key ,
expect_value lightbox_open == 0

# Brush pop-up: B, then a letter narrows the grid and puts an orange key on each brush.
key b
expect "Brushes/Standard"
expect "Brushes/Clay"
wait_idle 60
shot picker-brush
key c
expect_text [R]
expect_not "Brushes/Standard"
shot picker-brush-c
key r
expect_not "Brushes/Clay"
expect_status Brush: Crease
key b
key s
key t
expect_status Brush: Standard
# Backspace undoes a letter, Esc closes without picking.
key b
key s
key h
expect_status Brush: Tendril
key b
key z
expect_text No brush matches
key backspace
expect "Brushes/Standard"
# Brushes used lately come first.
expect_text Recent
wait_idle 30
shot picker-brush-recent
key escape
expect_not "Brushes/Standard"

# Material pop-up: hovering previews on the model, a click keeps it.
key m
expect "Materials/Red Wax"
hover "Materials/Red Wax"
shot picker-material-hover
click "Materials/Bronze"
expect_status Material: Bronze
expect_not "Materials/Red Wax"

# Draw Size / Z Intensity at the cursor: type a number and press Enter.
key s
expect "##cursorvalue"
expect_text Draw Size 60
key 1
key 2
key 0
key enter
key s
expect_text Draw Size 120
key escape
key u
expect "##cursorvalue"
expect_text Intensity 50
shot strength-popup
key escape
expect_not "##cursorvalue"   # (the top shelf always shows its own Z Intensity slider)
