# gh#184 on a Micro level without Focus Detail (the only path Windows and macOS have; Windows CI's llvmpipe showed
# view_stale 0.112 after the first Undo, 0.13.11): the shading of tiles an edit changed followed within a per-frame
# budget, so Undo, Redo and Move showed stale patches for frames. Their shading must be whole on the next frame: the view
# right after each must match the same mesh sent up whole (view_stale, mean pixel difference 0-255). A Clay stroke's own
# catch-up may lag a few frames; it must be whole once idle. micro_focus_shade_now.sfui is the same on a streamed level.
# cold: SF_FOCUS_DETAIL is set here, and a warm server doesn't keep it between scripts.
run ui_look look=classic layout=classic
env SF_FOCUS_DETAIL 0
run new_sphere subdivisions=6
run micro_divide level=4
wait_idle 120
camera 0 0
key f
wait_idle 30

click "Clay##brush.clay"
brush_size 120
stroke 0.15 0.30 0.85 0.70 0.8
stroke 0.15 0.70 0.85 0.30 0.8
stroke 0.20 0.50 0.80 0.50 0.8
wait_idle 60
# (the strokes' own catch-up runs within the frame budget after the release, a slow runner's frames longer)
wait_value micro_pending_shading == 0 30
expect_value view_stale < 0.02

# Undo / Redo of the Clay strokes: whole at once (0.13.10: 27k-70k tiles still waiting, view_stale 0.07-0.11)
key ctrl+z
expect_value view_stale < 0.02
key ctrl+z
expect_value view_stale < 0.02
key ctrl+shift+z
expect_value view_stale < 0.02

# Move: whole right after the drag, and after its undo (0.13.10: ~190k tiles waiting, view_stale 0.07 / 0.94)
click "Move##brush.move"
brush_size 400
stroke 0.25 0.55 0.70 0.35 1.0
expect_value view_stale < 0.02
key ctrl+z
expect_value view_stale < 0.02
