# Gizmo 3D (W Move, E Scale, R Rotate, Q Draw): each mode's handles, axis-locked moves, Shift snapping, Alt+drag
# moving only the gizmo, scaling, posing a capsule arm at the elbow (mask, pivot, soft falloff), undo / redo,
# numeric entry, All SubTools.
run new_sphere subdivisions=5 ; transform scale=3,0.7,0.7 pivot=origin ; subtool_rename to=Arm
key f
orbit -70 -45
expect_value size_x > 5.9
remember center_x cx0
remember center_y cy0
remember center_z cz0

# W: Move mode shows the gizmo and its panel; the top shelf's Move lights up.
key w
expect_value gizmo_mode == 1
expect "Gizmo/Apply"
expect_value wireframe == 0
gizmo_hover move_x
wait 0.2
expect_value gizmo_hover == 1
shot move-mode

# An arrow moves along its axis only.
snapshot
gizmo_drag move_x 90 0
expect_value moved > 1000
expect_value center_y == $cy0
expect_value center_z == $cz0
expect_value can_undo == 1
expect_status Gizmo Move
shot moved-x
remember pivot_x px1
expect_value pivot_x > 0.2
key ctrl+z
expect_value moved == 0
expect_value center_x == $cx0
# The gizmo goes back with the model, and forward again on redo.
expect_value pivot_x < 0.001
key ctrl+shift+z
expect_value pivot_x == $px1
key ctrl+z

# The view-plane centre moves freely; a plane square moves in its plane.
gizmo_drag move_view 60 -40
expect_value moved_max > 0.1
key ctrl+z
gizmo_drag plane_xz 40 30
expect_value center_y == $cy0
key ctrl+z
expect_value moved == 0

# Shift snaps a move to the grid (0.2 for a model this size).
hold shift
gizmo_drag move_y 0 -70
hold none
expect_value center_y > 0.19
remember center_y snapped
expect_value center_y == $snapped
key ctrl+z

# Alt+drag moves only the gizmo; Reset brings it back to the centre.
hold alt
gizmo_drag move_x 80 0
hold none
expect_value moved == 0
expect_value pivot_x > 0.3
expect_value pivot_y < 0.001
expect_value pivot_y > -0.001
shot pivot-moved
click "Reset##gizmo.reset_pivot"
expect_value pivot_x < 0.01
expect_value pivot_x > -0.01

# E: Scale. The centre scales evenly, a box along one axis.
key e
expect_value gizmo_mode == 2
gizmo_hover scale_uniform
shot scale-mode
remember size_y sy0
gizmo_drag scale_uniform 50 -50
expect_value size_y > $sy0*1.4
key ctrl+z
expect_value size_y == $sy0
gizmo_drag scale_y 0 -60
expect_value size_y > $sy0*1.2
remember size_x sx0
expect_value size_x == $sx0
key ctrl+z

# R: Rotate. Pose the forearm: mask the upper arm, Alt+click the elbow for the pivot, soften the joint, turn.
key r
expect_value gizmo_mode == 3
shot rotate-mode
run mask_rect x0=-1 y0=-1 x1=0 y1=1
expect_value masked > 1000
# The gizmo jumps to the centre of the unmasked forearm.
wait 0.1
expect_value pivot_x > 1
hold alt
click_subtool Arm 0.5 0.5
hold none
expect_value pivot_x < 0.8
expect_value pivot_x > -0.8
expect_status Pivot on Arm
drag_item "Gizmo/##gizmo_falloff" 25 0
expect_value gizmo_falloff > 0.05
snapshot
gizmo_hover rotate_z
shot rotate-hover
gizmo_drag rotate_z 0 -90 0.5 keep
# Mid-drag: the swept angle and the readout show beside the gizmo.
expect_text "deg"
shot posing-mid-drag
release
wait 0.1
expect_value moved > 1000
expect_value moved_max > 1
expect_status Gizmo Rotate
shot posed
# The masked upper arm stayed where it was.
expect_value moved_masked == 0
key ctrl+z
expect_value moved == 0
key ctrl+shift+z
expect_value moved > 1000
shot posed-redo
key ctrl+z
run mask_clear

# Every control explains itself with Ctrl held; Ctrl+F1 opens this chapter of the guide.
hold ctrl
hover "Gizmo/Apply"
expect_help "about the pivot"
hover "Gizmo/##gizmo_falloff"
expect_help "soft joint"
hover "Gizmo/To Surface##gizmo.snap_pivot"
expect_help "Alt+click"
hover "Gizmo/All Parts##gizmo.all"
expect_help "Transpose All"
hover "Rotate##tool.rotate"
expect_help "pose a limb"
key ctrl+f1
hold none
expect_guide gizmo.md
shot help-guide
key shift+f1
expect_value guide_open == 0

# Numeric entry: type the amounts, Apply runs one transform command about the pivot.
click "Reset##gizmo.reset_pivot"
type "Gizmo/##gizmo_rotate_z" 90
click "Gizmo/Apply"
expect_status Transformed
expect_value size_y > 5.9
expect_value can_undo == 1
shot numeric
key ctrl+z
click "Gizmo/Clear"

# All SubTools moves every visible SubTool together, with an undo step in each.
run subtool_append type=sphere name=Ball
key f
key w
click "All Parts##gizmo.all"
gizmo_drag move_view 50 40
expect_value edited_subtools == 2
shot all-subtools
click "All Parts##gizmo.all"

# Q (or W again) goes back to Draw: the gizmo and its panel go away and brushes sculpt again.
key w
expect_value gizmo_mode == 0
key r
key q
expect_value gizmo_mode == 0
expect_not "Gizmo/Apply"
shot draw-mode
