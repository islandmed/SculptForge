# #34: Append > Insert on the model with your own mesh: a copy of another SubTool, or a model file.
run new_sphere subdivisions=4
key f
click "SubTools/Append"
click "Cube"
expect_value subtools == 2
run subtool_select index=0
key f

# A copy of the Cube SubTool, dragged onto the sphere (X symmetry is on: a mirrored copy too), one undo step.
remember triangles base
click "SubTools/Append"
hover "Insert on the model"
hover "Active Part's copy..."
click "Cube##insertcopy1"
expect_status Insert a copy of Cube
stroke 0.8 0.45 0.86 0.45
expect_status 2 Cubes (mirrored)
expect_value triangles > $base
expect_value subtools == 2
shot insert_subtool_copy
key ctrl+z
expect_value triangles == $base

# From file: the path the file dialog answers with; the next drag inserts it.
choose_file insert data/stud.obj
wait 0.1
expect_status Insert stud.obj
stroke 0.8 0.45 0.86 0.45
expect_status 2 studs (mirrored)
expect_value triangles == $base+16
shot insert_file
key escape
expect_status Insert off
