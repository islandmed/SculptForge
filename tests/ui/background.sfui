# The view's background (#21): Gradient (the default) or Flat Colour with a colour picker, in Preferences > Display
# and the Render palette; kept by Store Config and in projects, and scriptable (set_background).
run ui_look look=classic layout=zbrush        # written for the Classic look and the ZBrush-style palette bar and shelves
run new_head
camera 20 5
key f
expect_value gradient_background == 1
shot gradient

# Preferences > Display: Gradient | Flat Colour and the colour.
click "Preferences##palette.preferences"
click "Display##preferences.display"
expect "Gradient##view.background_gradient"
expect "Flat Colour##view.background_flat"
expect_text "Background colour"
click "Flat Colour##view.background_flat"
expect_status "Background: Flat Colour"
expect_value gradient_background == 0
shot preferences-display
key escape
hover "Tool/Parts"
shot flat

# A colour of your own, from a script.
run set_background color=60,70,80
expect_value gradient_background == 0
expect_value background_r == 60
expect_value background_b == 80
hover "Tool/Parts"
shot flat-blue

# The Render palette has the same controls.
click "Render##palette.render"
expect "Gradient##view.background_gradient"
expect_text "Background colour"
click "Gradient##view.background_gradient"
expect_value gradient_background == 1
key escape

# Store Config keeps it for the next session (Restore Custom UI reads it back).
run set_background mode=flat
key ctrl+shift+i
expect_status "UI configuration stored"
run set_background mode=gradient
key f3
type "##Command palette" "restore custom"
key enter
expect_status "Custom UI restored"
expect_value gradient_background == 0
expect_value background_r == 60

# Projects keep their own.
run save_project path=sf_ui_background.sfproj
run set_background mode=gradient
run open path=sf_ui_background.sfproj
expect_value gradient_background == 0
expect_value background_b == 80
run set_background mode=gradient
