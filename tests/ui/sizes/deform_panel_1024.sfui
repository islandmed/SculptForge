# tests/ui/sizes/deform_panel.sfui on a 1024x768 window (CMake: ui_deform_panel_1024): narrower than 1280 px the
# right tray is not drawn and Tool opens as a drop-down from the bar (it only flashed the hidden tray before). Also at
# 2048x1536 = 1024 logical px at 200 % (ui_deform_panel_1024_200): the drop-down stays inside the window.
logical_width 1024
run ui_look look=classic layout=classic
run new_sphere subdivisions=5
run deform_scale amount=100 axes=y
click "Frame##view.frame"
click "Tool##palette.tool"
wait_idle 10
click "Reshape##tool.deformation"
expect "Size/##deform_size_x"
click "##deform_stack_add"
click "Stack/Taper##deform_add_Taper"
click "##deform_stack_add"
click "Stack/Twist##deform_add_Twist"
click "##deform_stack_add"
click "Stack/Bend##deform_add_Bend"
expect_status "Deform stack (3 steps)"
click "Stack/Z"
expect_status "Deform stack (3 steps)"
wait_idle 30
shot deform-panel
expect_value offscreen_items == 0
