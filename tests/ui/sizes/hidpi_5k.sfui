# A 5K monitor (5120x2880; fenix on Discord, 11-08): at 200, 250 and 300 % UI scale the shelves, brush tiles, Library
# tiles and the transform gizmo grow by the scale and keep their shape (shots for the look review). On a 2x display
# (macOS Retina, a scaled Wayland output) the fonts and icons are rasterised at the pixel density, not stretched from
# a 1x atlas; the atlas stays within 4096x8192 (Traditional Chinese, the largest, measured 4096x4442 at 2x / 200 %).
# CMake runs it at 5120x2880.
run ui_look look=classic layout=classic
run new_sphere subdivisions=2
key ,
expect_value library_open == 1
click "All##tool.gizmo_all"
expect_value gizmo_mode == 4

ui_scale 200
expect_value ui_scale == 200
expect_value font_height >= 29
expect_value font_height <= 31
expect_value panel_width >= 103
expect_value panel_width <= 105
expect_value font_density == 100
expect_value glyph_texels >= 92
expect_value glyph_texels <= 108
shot scale_200

ui_scale 250
expect_value ui_scale == 250
expect_value font_height >= 36.5
expect_value font_height <= 38.5
expect_value panel_width >= 129
expect_value panel_width <= 131
shot scale_250

ui_scale 300
expect_value ui_scale == 300
expect_value font_height >= 44
expect_value font_height <= 46
expect_value panel_width >= 155
expect_value panel_width <= 157
expect_value font_atlas_kpx <= 33554
expect_value glyphs_missing == 0
shot scale_300

# 1x at 100 %: the baseline (the app: 1024x1495, ~6 MB as RGBA; a test also has demo captions sized for its frame).
ui_scale 100
expect_value font_atlas_kpx <= 4096
remember font_atlas_kpx a1x

# A 2x display: the same layout (logical px), the glyphs at the pixel density, measured in the atlas: 2x up to
# 150 %, then less (UI scale x density at most 3), and the atlas stays within 4096x8192.
ui_scale 150
pixel_density 200
expect_value ui_scale == 150
expect_value font_density == 200
expect_value glyph_texels >= 184
expect_value glyph_texels <= 216
expect_value font_height >= 21.5
expect_value font_height <= 23.5
expect_value panel_width >= 77
expect_value panel_width <= 79
ui_scale 200
expect_value font_density == 150
expect_value glyph_texels >= 138
expect_value glyph_texels <= 162
expect_value font_atlas_kpx <= 33554
ui_scale 300
expect_value font_density == 100
expect_value font_atlas_kpx <= 33554

# A common 2x laptop at 100 %: the atlas at most 4x the 1x one (the icons the UI uses only; no power-of-two height).
ui_scale 100
expect_value font_density == 200
expect_value font_atlas_kpx <= $a1x*4
pixel_density 100
expect_value font_density == 100
expect_value glyph_texels >= 92
expect_value glyph_texels <= 108

