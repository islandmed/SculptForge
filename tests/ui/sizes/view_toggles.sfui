# The right shelf with the view toggles (Turntable, Ortho, Floor, Flat; foirgairwolf on Discord) and the Size slider's
# live ring (ABHITAR), for the look review at 1440 logical px (CMake: 100 % and 200 %). Nothing in the column is cut
# off at this size.
run ui_look look=forge layout=sculptforge
run new_sphere subdivisions=4
key f
camera 30 -15
mouse_move 0.5 0.5
wait 0.3
expect_value right_column_clipped == 0
shot column-off
click "Turntable##view.turntable"
click "Orthographic##view.ortho"
click "Floor grid##view.floor_grid"
click "Flat shading##view.flat_shading"
wait 0.3
expect_value right_column_clipped == 0
shot column-on
drag_item "##drawsize" 60 0 0.4 keep
expect_value size_slider_ring == 1
shot size-ring
release
wait 0.8
expect_value size_slider_ring == 0
# The classic layout's column too.
run ui_look look=classic layout=classic
wait 0.3
expect_value right_column_clipped == 0
shot classic-column
