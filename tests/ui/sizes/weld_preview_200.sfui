# Merge by Distance's preview at 200% (2880 px wide: 1440 logical): no dots with the panel just open, dots while the
# distance is dragged, none once it is let go (tests/ui/mesh_check.sfui is the 100% run).
run open path=$SCRIPT_DIR/../../data/check_mesh_cube.obj
ui_scale 200
click "Geometry##tool.geometry"
# (Check scrolls Check Mesh, just below Merge by Distance, into view)
click "Check##mesh_check"
wait 0.5
expect_value weld_preview_points == 0
expect_text 16 points will merge
shot panel-open
drag_item "##weld_distance" 4 0 0.3 keep
expect_value weld_preview_points == 16
shot dragging
release
hover "Check##mesh_check"
wait 0.6
expect_value weld_preview_points == 0
shot released
