# The first start's language (#44): an OS language SculptForge ships starts the interface in it, with a small bar
# ("SculptForge is in Español. [Change]", in that language and English); any other OS language keeps English and the
# welcome's language row is the offer (each name in its own script, one click, live). Tests never detect by themselves:
# `first_run_language os=<tag>` makes the decision a first start would. CMake runs it at 1440 and 2880 px wide.
run ui_look look=classic layout=classic        # the Classic palette bar: its ids are the same in every language
run new_sphere subdivisions=2

# pt-BR (not shipped) and en-US: nothing switches, no bar.
first_run_language os=pt-BR
expect_value language_bar_open == 0
first_run_language os=en_US.UTF-8
expect_value language_bar_open == 0
expect_no_text "Idioma"

# The welcome's language row: all five names in their own script; one click switches the whole interface, live.
key f3
type "##Command palette" "welcome"
key enter
expect_value welcome_open == 1
expect_text "Language:"
expect "English##welcome.language.en"
expect "Español##welcome.language.es"
expect "繁體中文##welcome.language.zh-TW"
expect "简体中文##welcome.language.zh-CN"
expect "日本語##welcome.language.ja"
shot first-run-language-row
click "Español##welcome.language.es"
wait 0.3
expect_text "Idioma:"
expect_value welcome_open == 1
shot first-run-language-es
click "繁體中文##welcome.language.zh-TW"
wait 0.3
expect_text "語言："
shot first-run-language-zh-tw
click "简体中文##welcome.language.zh-CN"
wait 0.3
expect_text "语言："
shot first-run-language-zh-cn
click "日本語##welcome.language.ja"
wait 0.3
expect_text "言語:"
shot first-run-language-ja
click "English##welcome.language.en"
wait 0.3
expect_text "Language:"
expect_no_text "Idioma"
click "Close##welcome"
expect_value welcome_open == 0

# es-MX: starts in Spanish with the bar, in Spanish and English.
first_run_language os=es-MX
wait 0.3
expect_value language_bar_open == 1
expect_text "SculptForge está en Español."
expect_text "SculptForge is in Español."
shot first-run-language-bar-es
# Change opens Preferences > Interface, where the language is.
click "Cambiar##languagebar"
wait 0.2
expect_value language_bar_open == 0
expect "Español##language.es"
shot first-run-language-bar-change
click "English##language.en"
wait 0.3
key escape
expect "Preferences##palette.preferences"

# zh-HK is Traditional, zh-SG Simplified; the bar goes when the language is changed another way.
first_run_language os=zh-HK
wait 0.3
expect_value language_bar_open == 1
expect_text "SculptForge 的介面語言是 繁體中文。"
shot first-run-language-bar-zh-tw
first_run_language os=zh-SG
wait 0.3
expect_text "SculptForge 的界面语言是 简体中文。"
shot first-run-language-bar-zh-cn
click "知道了##languagebar"
expect_value language_bar_open == 0
# ja-JP is Japanese: the bar in Japanese and in English.
first_run_language os=ja-JP
wait 0.3
expect_value language_bar_open == 1
expect_text "SculptForgeは日本語で表示されています。"
expect_text "SculptForge is in 日本語."
shot first-run-language-bar-ja
click "了解##languagebar"
expect_value language_bar_open == 0
click "環境設定##palette.preferences"
click "English##language.en"
expect "Preferences##palette.preferences"
key escape
first_run_language os=zh-SG
wait 0.3
click "偏好设置##palette.preferences"
click "English##language.en"
expect "Preferences##palette.preferences"
key escape
expect_text "Size"
