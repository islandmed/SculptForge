# Drape in a scene modelled in centimetres (the Full Body starter: 167 units tall): Units per metre starts from the size of
# the scene (100), so the default Simulate drops a cloth onto a table beside the figure and comes to rest, instead of
# simulating a 167 m scene that stops after the frame limit.
run ui_look look=classic layout=classic
run new_starter_mesh name=full-body levels=0
run part_append type=cube size=0.5 name=Table      # size is relative to the figure: a table 83 cm across, beside it
run part_append type=plane size=0.35 name=Cloth    # a 58 cm square of cloth
run transform translate=-76.6,56.7,0               # over the middle of the table, 15 cm above it
camera 25 -15
look 45 95 0
zoom 1.2
click "Tool##palette.tool"
click "Drape##tool.drape"
expect "##drapescale"
expect_value drape_scale == 100
snapshot
click "Simulate##drape"
wait_value drape_running == 1 10
wait_value drape_running == 0 120
expect_status Drape: at rest
wait_idle 30
shot cloth_drape_units
key ctrl+z
