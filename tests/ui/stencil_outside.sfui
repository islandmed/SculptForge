# The Stencil's "Outside the image" option: a stroke past the image's edge sculpts as if there were no Stencil (Sculpt, the
# default, in Classic too); Block keeps the old behaviour (nothing off the image). Tiled images cover the view either way.
run ui_look look=classic layout=classic
run new_sphere subdivisions=5
key f
click "Standard##brush.standard"
run brush_set_alpha name=cobblestone
run stencil_load alpha=true reset=true
run brush_set_alpha name=round
wait 0.1
run stencil_set size=0.35 x=0.3
click "X##transform.symmetry_x"
expect_value symmetry_x == 0
expect_value stencil_outside_sculpts == 1
click "Alpha##palette.alpha"
expect "##stencil.outside"
shot panel
click "Alpha##palette.alpha"

# Sculpt (default): a stroke on the right, well off the image, moves the mesh.
snapshot
stroke 0.6 0.5 0.9 0.5
expect_value moved > 0
expect_value moved_off_stencil > 0
shot sculpt
key ctrl+z

# Block: the same stroke does nothing off the image.
run stencil_set outside=block
expect_value stencil_outside_sculpts == 0
snapshot
stroke 0.6 0.55 0.9 0.55
expect_value moved == 0
shot block

# Tiled: the image covers the view, Block or not: the stroke sculpts.
run stencil_set tile=true
snapshot
stroke 0.6 0.5 0.9 0.5
expect_value moved > 0
