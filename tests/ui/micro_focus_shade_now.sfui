# gh#184 (0.13.10): on a streamed Micro level (Focus Detail) the coarse shading of tiles a Clay stroke changed follows
# within a per-frame budget; Undo, Redo and Move showed it too, as dark patches for seconds. Their shading must be
# whole on the next frame: the view right after each must match the same mesh sent up whole (view_stale, mean
# pixel difference 0-255). A Clay stroke's own catch-up may lag a few frames; it must be whole once idle. (The tiles still
# waiting are printed, not checked: on slow frames Focus Detail's streaming queues a few of its own, within the budget.)
# (Focus Detail is POSIX only: on Windows this runs the plain micro path, which micro_shade_now.sfui covers on every platform.)
# cold: SF_FOCUS_DETAIL is set here, and a warm server doesn't keep it between scripts.
run ui_look look=classic layout=classic
env SF_FOCUS_DETAIL 1
run new_sphere subdivisions=6
run micro_divide level=4
env SF_FOCUS_DETAIL 0
wait_idle 120
camera 0 0
key f
wait_idle 30

click "Clay##brush.clay"
brush_size 120
stroke 0.15 0.30 0.85 0.70 0.8
stroke 0.15 0.70 0.85 0.30 0.8
stroke 0.20 0.50 0.80 0.50 0.8
wait_idle 60
expect_value view_stale < 0.02

# Undo / Redo of the Clay strokes: whole at once (0.13.10: 27k-70k tiles still waiting, view_stale 0.07-0.11)
key ctrl+z
print micro_pending_coarse
expect_value view_stale < 0.02
key ctrl+z
print micro_pending_coarse
expect_value view_stale < 0.02
key ctrl+shift+z
print micro_pending_coarse
expect_value view_stale < 0.02

# Move: whole right after the drag, and after its undo (0.13.10: ~190k tiles waiting, view_stale 0.07 / 0.94)
click "Move##brush.move"
brush_size 400
stroke 0.25 0.55 0.70 0.35 1.0
print micro_pending_coarse
expect_value view_stale < 0.02
key ctrl+z
print micro_pending_coarse
expect_value view_stale < 0.02
