# Adaptive Detail tiles drawn (SF_MICRO_TILES=1, render/MicroTilePages.h): a Micro 4 sphere (49k base triangles, stored
# cells about 1/1200 of the model) and a small Standard stroke (a line and three dots, 30 px from 0.4 away: finer than the
# stored cell x 48, so it writes delta tiles instead of the stored grid). BEFORE: the same stroke with tiles off (it lands on
# the stored grid); AFTER: with tiles on, drawn through the delta pages. Each is shot at three zooms (where it was made, 1/20
# and 1/70 of the model), lit and flat. (stroke fractions are of the model's projected box, which spans several
# screens this close: 0.49-0.51 is about the middle fifth of the view.) Sizes from the caller (--size 1440x900 and 2880x1800).
run ui_look look=classic layout=classic
run new_sphere subdivisions=6
run micro_divide level=4
wait_idle 120
camera 0 0
look 0 0 1
camera_distance 0.4
brush_size 30
# --- before: tiles off
env SF_MICRO_TILES 0
stroke 0.490 0.497 0.510 0.497
stroke 0.494 0.503 0.494 0.503
stroke 0.500 0.503 0.500 0.503
stroke 0.506 0.503 0.506 0.503
wait_idle 60
expect_value micro_tiles == 0
shot before-zoom1
camera_distance 0.1
wait_idle 60
shot before-zoom2
click "Flat shading##view.flat_shading"
wait_idle 30
shot before-zoom2-flat
click "Flat shading##view.flat_shading"
camera_distance 0.03
wait_idle 60
shot before-zoom3
click "Flat shading##view.flat_shading"
wait_idle 30
shot before-zoom3-flat
click "Flat shading##view.flat_shading"
run undo
run undo
run undo
run undo
camera_distance 0.4
wait_idle 60
# --- after: tiles on, the same stroke
env SF_MICRO_TILES 1
stroke 0.490 0.497 0.510 0.497
stroke 0.494 0.503 0.494 0.503
stroke 0.500 0.503 0.500 0.503
stroke 0.506 0.503 0.506 0.503
wait_idle 60
expect_value micro_tiles > 0
expect_value micro_tile_pages > 0
shot after-zoom1
camera_distance 0.1
wait_idle 60
expect_value micro_tile_pages > 0
shot after-zoom2
click "Flat shading##view.flat_shading"
wait_idle 30
shot after-zoom2-flat
click "Flat shading##view.flat_shading"
camera_distance 0.03
wait_idle 60
shot after-zoom3
click "Flat shading##view.flat_shading"
wait_idle 30
shot after-zoom3-flat
click "Flat shading##view.flat_shading"
# undo and redo: the tiles go and come back (pages follow)
run undo
run undo
run undo
run undo
wait_idle 30
expect_value micro_tiles == 0
shot after-undone-zoom3
run redo
run redo
run redo
run redo
wait_idle 30
expect_value micro_tiles > 0
shot after-redone-zoom3
env SF_MICRO_TILES 0
