# The Blender bridge (File > Blender): what the add-on sends loads by itself (checked every frame in UI tests,
# once a second in the app), Send to Blender writes the SubTools back, and a second send from Blender updates
# the SubTool it came from (undoable) and adds the new object. The sends are staged from tests/ui/data/blender
# into an exchange folder in the working directory (the build folder under ctest).
run new_sphere subdivisions=3
env SCULPTFORGE_BLENDER_EXCHANGE sf_ui_blender
copy data/blender/send1 sf_ui_blender/to_sculptforge
wait 0.2
expect_status "Received 2 objects from Blender"
expect_value subtools == 2
expect_value active_subtool == 0
expect_text Box
expect_text Rock
expect_value colored > 0
shot received

# The menu: File > Blender, with Ctrl-hover help on its items.
click "File##palette.file"
expect "Export STL...##file.export_stl"
hover "Blender"
wait 0.2
expect "Send to Blender##file.send_blender"
expect "Receive automatically##blender"
shot menu
hold ctrl
hover "Send to Blender##file.send_blender"
expect_help "back to Blender"
hover "Receive automatically##blender"
expect_help "as soon as it arrives"
hold none
click "Send to Blender##file.send_blender"
expect_status "Sent 2 objects to Blender"

# Blender sends again: the box changed and a pebble is new.
copy data/blender/send2 sf_ui_blender/to_sculptforge
wait 0.2
expect_status "Received 2 objects from Blender"
expect_value subtools == 3
expect_text Pebble
expect_value can_undo == 1
shot updated
# Both receives into the box are undo steps: the update, then the first one (which replaced the fresh sphere).
key ctrl+z
expect_value can_undo == 1
key ctrl+z
expect_value can_undo == 0
