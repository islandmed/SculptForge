# SubTools: the panel, Alt+click in the viewport, sculpting and undo per SubTool,
# visibility, rename, duplicate, delete, merge and split.
run new_sphere subdivisions=4 ; subtool_rename to=Body
expect "SubTools/Append"
expect_value subtools == 1
expect "SubTools/Body"
shot one-subtool

# Append from the panel's menu: each new SubTool becomes the active one.
click "SubTools/Append"
click "Sphere"
expect_status Appended Part Sphere
expect_value subtools == 2
expect_value active_subtool == 1
click "SubTools/Append"
click "Cube"
expect_value subtools == 3
expect_value active_subtool == 2
key f
shot appended

# Click rows to select.
click "SubTools/Body"
expect_value active_subtool == 0
expect_status Active Part: Body
click "SubTools/Sphere"
expect_value active_subtool == 1

# Alt+click in the viewport selects another SubTool without sculpting anything.
hold alt
click_subtool Cube
hold none
expect_value active_subtool == 2
expect_status Active Part: Cube
hold alt
click_subtool Body
hold none
expect_value active_subtool == 0
expect_value edited_subtools == 0
shot alt-click

# Shift+Alt+click selects a SubTool and frames it (ZBrush): the camera moves in on the Cube.
remember camera_distance far
hold shift+alt
click_subtool Cube
hold none
expect_value active_subtool == 2
expect_value camera_distance < $far
expect_value edited_subtools == 0
shot shift-alt-frame
key f
hold alt
click_subtool Body
hold none
expect_value active_subtool == 0

# A stroke changes only the active SubTool; undo history is per SubTool.
click "Clay##brush.clay"
stroke 0.3 0.4 0.6 0.6
expect_value can_undo == 1
expect_value edited_subtools == 1
# Alt+drag on the active SubTool is still an inverted stroke, not a selection.
hold alt
stroke 0.4 0.3 0.5 0.7
hold none
expect_value active_subtool == 0
expect_value edited_subtools == 1
shot sculpted
click "SubTools/Cube"
expect_value can_undo == 0
key ctrl+z
expect_value edited_subtools == 1
click "SubTools/Body"
expect_value can_undo == 1
key ctrl+z
key ctrl+z
expect_value can_undo == 0
expect_value edited_subtools == 0
key ctrl+shift+z
expect_value edited_subtools == 1

# Eye toggles, Solo and Unhide all.
click "SubTools/##eye Sphere"
expect_value visible_subtools == 2
expect_status Sphere hidden
shot hidden
click "SubTools/Solo"
expect_value visible_subtools == 1
expect_status Solo: Body
shot solo
click "SubTools/Solo"
expect_value visible_subtools == 3
click "SubTools/##eye Cube"
expect_value visible_subtools == 2
click "SubTools/Unhide all"
expect_value visible_subtools == 3

# Rename: double-click the row and type.
double_click "SubTools/Cube"
type "SubTools/##rename" Helmet
key enter
expect_status Renamed to Helmet
expect "SubTools/Helmet"
expect_not "SubTools/Cube"

# Duplicate, then delete through the confirmation (Cancel first).
click "SubTools/Helmet"
click "SubTools/Duplicate"
expect_value subtools == 4
expect_value active_subtool == 3
expect "SubTools/Helmet copy"
click "SubTools/Delete..."
expect_text This can't be undone
shot confirm-delete
click "Delete Part?/Cancel"
expect_value subtools == 4
click "SubTools/Delete..."
click "Delete Part?/Delete"
expect_value subtools == 3
expect_status Deleted Part Helmet copy
expect_not "SubTools/Helmet copy"

# Move the active SubTool up and down the list.
click "SubTools/Sphere"
click "SubTools/##up"
expect_value active_subtool == 0
click "SubTools/##down"
expect_value active_subtool == 1

# Merge down keeps polygroups apart, so Split groups separates the pieces again.
click "SubTools/Body"
click "SubTools/Merge down..."
click "Merge Down?/Merge"
expect_value subtools == 2
expect_status Merged Sphere into Body
expect_value can_undo == 0
click "SubTools/Split groups"
expect_value subtools == 3
expect_status Split into 2 Parts
shot split-groups
click "SubTools/Merge visible..."
click "Merge Visible?/Merge"
expect_value subtools == 1
expect "SubTools/Merged"
click "SubTools/Split parts"
expect_value subtools == 3
expect_status Split into 3 Parts
shot split-parts

# The Tool palette's SubTool sub-palette closes and opens.
click "Parts##tool.subtool"
expect_not "SubTools/Append"
click "Parts##tool.subtool"
expect "SubTools/Append"

# Wireframe, polygroup colours and the LOD preview are for the active SubTool only.
key shift+f
expect_value wireframe == 1
click "Face Groups"
click "Show face groups"
shot active-overlays
click "Show face groups"
key shift+f
click "Export"
click "Generate LOD chain"
shot lod-preview
click "Game Ready/Sculpt"
click "Parts##tool.subtool"

# Past six SubTools the list scrolls; clicks scroll it like a person would.
run subtool_append ; subtool_append ; subtool_append ; subtool_append
expect_value subtools == 7
expect_value active_subtool == 6
shot many
click "SubTools/Merged 1"
expect_value active_subtool == 0
