# SubTools survive files: build a scene in the UI, save a project, reopen it, and round-trip GLB / OBJ.
# Files are written to the working directory (the build folder under ctest).
run new_sphere subdivisions=4
click "Parts/Append"
click "Cube"
click "Parts/Append"
click "Sphere"
expect_value subtools == 3
double_click "Parts/Sphere 2"
type "##rename" Eye
key enter
expect_text Eye
click "Parts/Cube"
stroke 0.4 0.4 0.6 0.6
expect_value edited_subtools == 1
click "Parts/##eye Eye"
expect_value visible_subtools == 2
shot before-save

run save_project path=sf_ui_subtools.sfproj
run new_sphere subdivisions=2
expect_value subtools == 1
run open path=sf_ui_subtools.sfproj
expect_value subtools == 3
expect_value visible_subtools == 2
expect_value active_subtool == 1
expect_value dirty == 0
expect_text Eye
shot reopened

# Exports carry the visible SubTools only; opening the export gives them back as SubTools.
run export_glb path=sf_ui_subtools.glb
run open path=sf_ui_subtools.glb
expect_value subtools == 2
run save_obj path=sf_ui_subtools.obj
run open path=sf_ui_subtools.obj
expect_value subtools == 2
shot obj-reopened
