# A micro level on a base under the triangle budget has no coarse levels to build: the app rests when idle (a frame
# asked for a coarse build that never comes kept it drawing; background_frames.sfui is the same check for jobs).
run new_sphere subdivisions=6
run micro_divide level=1
expect_status "Divided to micro"
window_focus 0
mouse_leave
# (in real time, with room for slow CI: its first-launch calibration and micro shading draw for a while too)
shot micro-idle-first
wait_value wants_frames == 0 60
# (a drawn frame of the micro level: the bug asked for more frames from it, and UI tests draw the 3D view only for
# shots; the first one can come before the micro shading is ready, and then draws without it)
shot micro-idle
wait_value wants_frames == 0 60
expect_value coarse_clusters == 0
window_focus 1
