# A press outside an open context menu or combo list closes it, wherever it lands (#210): on another row of the panel the menu
# came from, on the canvas (no stroke), with the pen too. Esc closes it as well. (A right-click menu opens under the pointer
# and covers the rows below it: the menus here open on the last row, and the clicks go to the row above.)
run ui_look look=classic layout=classic
run new_sphere subdivisions=3 ; part_rename to=Body
click "Parts/Append"
click "Cube"
expect_value parts == 2
expect_value active_part == 1

# A context menu on the last row, a left click on the row above it.
right_click "Parts/Cube"
expect_value popups_open == 1
shot menu_open
click "Parts/Body"
expect_value popups_open == 0
shot menu_closed_by_row

# The same menu, Esc.
right_click "Parts/Cube"
expect_value popups_open == 1
key escape
expect_value popups_open == 0

# The same menu, a click on the model: it closes and sculpts nothing.
remember undo_steps u0
right_click "Parts/Cube"
expect_value popups_open == 1
mouse_move 0.5 0.5
click_here
expect_value popups_open == 0
expect_value undo_steps == $u0

# A combo list (Append): a click on a row above it closes it.
click "Parts/Append"
expect_value popups_open == 1
click "Parts/Body"
expect_value popups_open == 0

# The pen: a tap on the row above closes a context menu, a tap on the model closes it without a stroke.
right_click "Parts/Cube"
expect_value popups_open == 1
pen_tap "Parts/Body"
expect_value popups_open == 0
right_click "Parts/Cube"
expect_value popups_open == 1
click_part Body 0.5 0.5 1 pen
expect_value popups_open == 0
expect_value undo_steps == $u0
