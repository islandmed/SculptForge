# #43: a triple-click on another SubTool in the viewport makes it the active one and frames it, without
# sculpting anything; single and double clicks on it don't select it.
run new_sphere subdivisions=3
run subtool_append type=cube name=Cube
run subtool_select index=0
key f
expect_value active_subtool == 0

# One or two clicks: still the sphere.
click_subtool Cube 0.5 0.5 2
expect_value active_subtool == 0

# Three: the Cube, framed (the camera moves in on it).
remember camera_distance far
click_subtool Cube 0.5 0.5 3
expect_value active_subtool == 1
expect_status Active Part: Cube
expect_value camera_distance < $far
expect_value edited_subtools == 0
shot triple_click_frame
