# #43: twelve more built-in alphas and six more VDM brushes, made in code at first use, with thumbnails in the
# LightBox (Alpha and Brush tabs) and in the Alpha picker; a double-click uses one.
run new_sphere subdivisions=5
key ,
expect_value lightbox_open == 1
click "Library/Alpha"
expect "Library/Round"
expect "Library/Pores"
expect "Library/Cracks"
expect "Library/Fabric Weave"
wait_idle 60
shot lightbox_alphas
# The rest are further along the strip; the filter finds them.
type "Library/##lbfilter" hair
expect "Library/Hair Strands"
expect_not "Library/Round"
type "Library/##lbfilter" fold
expect "Library/Skin Folds"
type "Library/##lbfilter" weave
expect "Library/Fabric Weave"
type "Library/##lbfilter" bark
expect "Library/Bark"
type "Library/##lbfilter" grid
expect "Library/Dot Grid"
wait_idle 60
shot lightbox_alphas_filtered
type "Library/##lbfilter" crack
double_click "Library/Cracks"
expect_status Alpha 'Cracks'
snapshot
stroke 0.3 0.5 0.7 0.5
expect_value moved > 100

# The VDM brushes, built-in ones included, in the Brush tab.
click "Library/Brush"
type "Library/##lbfilter" horn
expect "Library/Horn"
type "Library/##lbfilter" ledge
expect "Library/Rock Ledge"
type "Library/##lbfilter" line
expect "Library/Wrinkle Line"
wait_idle 60
shot lightbox_vdms
type "Library/##lbfilter" fold
expect "Library/Skin Fold"
type "Library/##lbfilter" rivet
double_click "Library/Rivet"
expect_status VDM 'Rivet'
expect_value brush_type == 14
key ,
expect_value lightbox_open == 0
