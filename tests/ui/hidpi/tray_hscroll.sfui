# Vertical trays and columns never scroll sideways (dm4nd on Discord, 0.11.13: auto UI scale, fullscreen 1920x1200, the
# right tray with Tool > Remesh open and the narrow Undo/Redo column scrolled horizontally). Every side column's items
# fit inside it (hscroll_windows: nothing wider inside than out), and a sideways swipe moves nothing (hscrolled_windows).
# CMake runs this at 1920x1200; logical_width plays the display scales Windows offers there (100 %, 125 %, 150 %), in
# the default look and in Classic.
ui_scale auto
run new_sphere subdivisions=3
click "Remesh##tool.remesh"
wait_idle 10
expect_value hscroll_windows == 0
wheel_item "Remesh##tool.remesh" -3 0
wheel_item "Undo##edit.undo" -3 0
expect_value hscrolled_windows == 0
shot remesh-100
logical_width 1536
wait_idle 30
expect_value hscroll_windows == 0
wheel_item "Remesh##tool.remesh" 3 0
expect_value hscrolled_windows == 0
shot remesh-125
logical_width 1280
wait_idle 30
expect_value hscroll_windows == 0
wheel_item "Undo##edit.undo" -3 0
expect_value hscrolled_windows == 0
shot remesh-150
run ui_look look=classic layout=classic
wait_idle 30
expect_value hscroll_windows == 0
shot classic-150
ui_scale 200
wait_idle 30
expect_value hscroll_windows == 0
shot classic-200
