# Close-ups of a Micro level past its stored resolution (TierBudgets::microDrawAbove, render/MicroRenderer.cpp posAt):
# a Micro 4 sphere (49k base triangles: stored cells 1/1200 of the model) with pore noise, seen from mid distance (nothing
# changes there), then with the camera at 1/100, 1/400 and 1/800 of the model's size, where the stored micro triangles
# used to show as facets. Shots for the
# before/after pair (before: SF_TIER_MICRO_DRAW_ABOVE=0) at --size 1440x900 and 2880x1800; sizes in the file names come
# from the caller's --ui-out folder.
run ui_look look=classic layout=classic
run new_sphere subdivisions=6
run micro_divide level=4
run micro_noise amplitude=0.0006 scale=60
run micro_noise amplitude=0.0002 scale=500 seed=2
wait_idle 120
camera 25 15
key f
wait_idle 30
shot micro-mid
# the camera looks down -z from (0, 0, distance) past its target: the target on the sphere's front (radius 1, noise < 0.003)
camera 0 0
look 0 0 1
# 1/100 of the model (diameter 2): about ten stored cells across the view
camera_distance 0.02
wait_idle 60
shot micro-close-100
run viewport_shading mode=flat
wait_idle 30
shot micro-close-100-flat
run viewport_shading mode=lit
# 1/400: two or three stored cells across the view (facets or smooth)
camera_distance 0.005
wait_idle 60
shot micro-close-400
run viewport_shading mode=flat
wait_idle 30
shot micro-close-400-flat
run viewport_shading mode=lit
# 1/800: inside two stored cells
camera_distance 0.0025
wait_idle 60
shot micro-close-800
run viewport_shading mode=flat
wait_idle 30
shot micro-close-800-flat
