# cold
# Deferred exact normals (App::deferNormals): a background stroke ends after its last dab, whose exact normals settle after
# it on the stroke thread. Meanwhile the brush ring stays on the surface and follows the pointer (it flipped to the flat
# ring), a shortcut waits for the settle instead of freezing a frame, and the settled mesh is the one the stroke leaves
# with SF_DEFER_NORMALS=0 (tests/test_deferred_normals.cpp checks that bit for bit). ctest sets SF_BACKGROUND_DABS and
# SF_SETTLE_DELAY_MS + SF_SETTLE_LEAVES (batches of 4 leaves, each held 50 ms, so the input below lands inside the settle and a
# press stops the batch in flight, then takes the rest over); all are read once at startup.
run ui_look look=classic layout=classic
run new_sphere subdivisions=6
interactive_strokes on
camera 0 0
key f
wait_idle 30
expect_value cursor_follows_surface == 1
brush_size 60
snapshot

# The ring during the settle: on the surface, at the pointer as it moves.
stroke 0.30 0.40 0.60 0.45 0.5
wait_value normals_settling == 1 60
hover_model 0.45 0.50
expect_value surface_cursor == 1
hover_model 0.60 0.55
expect_value surface_cursor == 1
hover_model 0.40 0.60
expect_value surface_cursor == 1
expect_value normals_settling == 1
wait_value normals_settling == 0 20000
wait_idle 30
expect_value moved > 100
expect_value undo_steps == 1

# A shortcut during the settle waits for it (queued), then runs: Undo takes the stroke back.
stroke 0.30 0.60 0.60 0.65 0.5
wait_value normals_settling == 1 60
key ctrl+z
expect_value normals_settling == 1
expect_value undo_steps == 2
wait_value normals_settling == 0 20000
wait_idle 30
expect_value undo_steps == 1

# A stroke pressed during the settle stops the batch in flight, then takes the pending normals over (each dab first works
# out those it reads: tests/test_deferred_normals.cpp checks the result bit for bit against a settle first). Its dabs aren't
# compared here: a held press replays its moves at once and places fewer (the xfail in async_stroke_press_waits.sfui).
key ctrl+z
wait_value normals_settling == 0 20000
wait_idle 30
expect_value moved == 0
stroke 0.30 0.40 0.60 0.45 0.5
wait_value normals_settling == 1 60
stroke 0.55 0.45 0.70 0.60 0.5
wait_value taken_over == 1 20000
wait_value normals_settling == 0 20000
wait_idle 30
expect_value undo_steps == 2
expect_value moved > 100
