# Two-key shortcuts fire when the two keys are pressed together (Artizmo on Discord): with C = Pick colour, V = Switch
# Color and "C then V" on Wireframe, V going down while C is held runs only the sequence, and so does C going down
# while V is held; tap, tap does too. A key of the sequence alone waits the Two-key window out and then runs by itself;
# keys in no sequence run at once. Real key down and up events, in every key style.
run ui_look look=classic layout=classic
run new_sphere subdivisions=3

# --- sculptforge keys ---
input_style sculptforge
set_shortcut color.pick C
set_shortcut color.switch V
set_shortcut view.wireframe C then V
expect_shortcut view.wireframe C then V
expect_value wireframe == 0
remember paint_r base
# V alone ends the sequence, so it waits the window out for a C and then runs.
key v
expect_value key_sequence_waiting == 1
wait 0.5
expect_value key_sequence_waiting == 0
expect_value paint_r != $base
key v
wait 0.5
expect_value paint_r == $base
# C and V together (V goes down while C is held): the sequence, neither key's own action.
key_down c
expect_value key_sequence_waiting == 1
key_down v
key_up v
key_up c
expect_value wireframe == 1
expect_value paint_r == $base
expect_value key_sequence_waiting == 0
# V first, C going down while V is still held: the same.
key_down v
key_down c
key_up c
key_up v
expect_value wireframe == 0
expect_value paint_r == $base
# V tapped and let go, then C: that is V, C in a row, not "C then V": V alone, then C alone.
key v
key c
wait 0.6
expect_value wireframe == 0
expect_value paint_r != $base
key v
wait 0.6
expect_value paint_r == $base
# Rolling: C up before V goes down, inside the window (tap, tap): the sequence.
key c
key v
expect_value wireframe == 1
expect_value paint_r == $base
# C held a little and let go, no second key: it runs alone, once, after the window.
key_down c
wait 0.2
expect_value key_sequence_waiting == 1
key_up c
wait 0.6
expect_value key_sequence_waiting == 0
# A V after the window is V alone.
key v
wait 0.6
expect_value wireframe == 1
expect_value paint_r != $base
key v
wait 0.6
expect_value paint_r == $base
# (back to the start)
key c
key v
expect_value wireframe == 0

