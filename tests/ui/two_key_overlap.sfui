# --- A full second: the window is a preference (Preferences > Input > Two-key window), 0.35 to 1 s ---
input_style sculptforge
set_shortcut color.pick C
set_shortcut color.switch V
set_shortcut view.wireframe C then V
two_key_window 1
key_down c
wait 0.7
expect_value key_sequence_waiting == 1
key_down v
key_up v
key_up c
expect_value wireframe == 1
expect_value key_sequence_waiting == 0
two_key_window 0.4
