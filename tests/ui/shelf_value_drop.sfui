# Customize Shelves: a value field (the Remesh palette's Voxel Resolution slider) drags onto a shelf like a button
# (masterfull95 on Discord: it only floated), moves with the shelf, still works there, and is kept across a restart.
run ui_look look=classic layout=classic
run new_sphere subdivisions=4
click "Remesh##tool.remesh"
expect_value voxel_resolution_on_shelves == 0
key f3
type "##Command palette" "customize shelves"
key enter
expect_value customize == 1

# Ctrl+Alt: the slider is picked up (its value doesn't move) and dropped on the bottom shelf.
remember voxel_resolution res
hold ctrl+alt
drag_item_to "##voxresgrab" "Clay##brush.clay" keep
remember ui_drag_payload payload_in_flight
remember shelf_drop_accepted accepted_before
release
wait 0.3
remember ui_drag_payload payload_after
remember shelf_drop_accepted accepted_after
remember voxel_resolution_on_shelves on_shelves
expect_value ui_drag_payload == 0
hold none
expect_value voxel_resolution == $res
expect_value voxel_resolution_on_shelves == 1
wait_idle 30
shot dropped

# Other work doesn't lose it (a brush pick, the Remesh palette closing), and the slider on the shelf works.
click "Clay##brush.clay"
click "Remesh##tool.remesh"
expect_value voxel_resolution_on_shelves == 1
key f3
type "##Command palette" "customize shelves"
key enter
expect_value customize == 0
drag_item "##voxres" 60 0
expect_value voxel_resolution != $res

# Kept at the next start.
restart
expect_value voxel_resolution_on_shelves == 1
wait_idle 30
shot restarted

# HiDPI.
ui_scale 200
wait_idle 60
shot dropped_hidpi
