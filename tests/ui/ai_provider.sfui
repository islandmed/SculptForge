# Brush Lab's AI provider panel: Free by default, local-model helpers for OpenAI-compatible.
# Brush Lab floats over the canvas, closed until the top shelf's AI Brush opens it.
run ui_look look=classic layout=zbrush        # written for the Classic look and the ZBrush-style palette bar and shelves
expect_not "Brush Lab/Create"
click "AI Brush"
expect "Brush Lab"
click "AI provider"
expect_text Free - no account or key
expect_text Pollinations.ai
expect_not "Endpoint"
shot ai-free

click "##provider"
click "OpenAI-compatible (OpenAI, Ollama, LM Studio...)"
expect "Ollama"
expect "LM Studio"
expect "Find models"
expect "Endpoint"
click "Run a model on this computer"
expect_text ollama pull qwen3:4b-instruct
shot ai-local-help

# Nothing listens on this port: the panel must say so instead of hanging.
type "Endpoint" http://127.0.0.1:9/v1/chat/completions
click "Find models"
wait_idle 15
expect_text Nothing is answering
shot ai-not-running

click "LM Studio"
click "Ollama"
expect_no_text Nothing is answering
