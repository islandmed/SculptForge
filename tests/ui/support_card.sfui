# The full membership card (Support.h, PanelSupportCard.cpp): shown on the first start only (the small card at good
# moments does the rest: member_card.sfui); never for a member, never in tests. Its buttons only ask for the fixed
# Stripe links (UI tests never start a browser), except I'm already a member: the GitHub sign-in.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=3
# A UI test is a test-mode start: no card.
expect_value support_card_open == 0
support_card first_run test_mode
expect_value support_card_open == 0

# The first start after install.
support_card first_run
expect_value support_card_open == 1
wait_idle
wait 1.2
expect_text SCULPTFORGE MEMBERSHIP
expect_text Free and open source.
expect_text Members keep it moving.
expect_text Every release stays free for everyone.
expect_text RECOMMENDED
expect_text Member
expect_text $5
expect_text $150
expect_text Betas and early builds of the next version
expect_text Up to 10 artists, each with everything in Member
expect_text invoiced monthly
expect_text or $48 a year
expect "Member, $48 a year##card.member_yearly"
shot first_run
# The members' Discord in the footer opens the invite (kDiscordUrl) and leaves the card open.
expect "Join the members on Discord##card.discord"
click "Join the members on Discord##card.discord"
expect_value discord_requests == 1
expect_status https://discord.gg/gWrYkEmQhH
wait 0.4
expect_value support_card_open == 1
expect_value support_requests == 0
# Clicks on the card never reach the canvas or the shortcuts underneath; a tier opens its Stripe checkout.
click "Become a member##card.member"
expect_value support_requests == 1
expect_status https://buy.stripe.com/aFacN5h1t6L8cP14ad4F201
wait 0.4
expect_value support_card_open == 0

# Help > Support (here Preferences > Support) shows it any time; the yearly Member checkout is in the footer.
click "Preferences##palette.preferences"
click "Support##preferences.support"
expect "I'm already a member##prefs.member_verify"
click "Show the memberships"
expect_value support_card_open == 1
wait 0.8
click "Member, $48 a year##card.member_yearly"
expect_value support_requests == 2
expect_status https://buy.stripe.com/aFa5kD4eHfhE2an6il4F206
wait 0.4
click "Show the memberships"
wait 0.8
click "Studio membership##card.studio"
expect_value support_requests == 3
expect_status https://buy.stripe.com/3cI00j12v5H4g1dgWZ4F204
wait 0.4

# Not now and Esc close it.
click "Show the memberships"
wait 0.8
expect_no_text Maybe later
click "Not now##card.later"
wait 0.4
expect_value support_card_open == 0
click "Show the memberships"
wait 0.8
key Escape
wait 0.4
expect_value support_card_open == 0

# "I'm already a member" starts the GitHub sign-in (the small card shows its steps); signed in, never again.
click "Show the memberships"
wait 0.8
click "I'm already a member##card.supporter_already"
wait 0.4
expect_value support_card_open == 0
expect_value member_card_verifying == 1
member_sign_in ok
wait 0.4
expect_value supporter == 1
expect_value member_signed_in == 1
support_card first_run
expect_value support_card_open == 0
expect_text Thank you for being a member! No membership cards show.
expect_value support_requests == 3
