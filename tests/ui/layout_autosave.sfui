# The layout saves itself (Discord #bug-reports, phoenix / raffaele_3d_design lost layout edits at quit): a layout edit
# reaches ui.json by itself ~2 s later, a restart (quit) keeps it, Save Layout only marks what Revert returns to.
run ui_look look=classic layout=classic
run new_sphere

# Edit, no Save Layout: written by itself, still there after a restart.
expect_value right_tray_open == 1
click "##rightdivider"
expect_value right_tray_open == 0
wait_value layout_autosaved == 1 6
restart
wait 0.2
expect_value right_tray_open == 0

# Save Layout with the tray closed, then open it again: that edit is autosaved, Revert goes back to the saved one.
key f3
type "##Command palette" "save layout"
key enter
expect_status "Layout saved"
click "##rightdivider"
expect_value right_tray_open == 1
restart
wait 0.2
expect_value right_tray_open == 1
action config.restore_custom
wait 0.3
expect_status "Saved layout restored"
expect_value right_tray_open == 0

# Reset Layout wins: it is what the autosave writes next; Revert after it still returns to the Save Layout one.
action config.reset_layout
wait 0.3
expect_value right_tray_open == 1
restart
wait 0.2
expect_value right_tray_open == 1
action config.restore_custom
wait 0.3
expect_value right_tray_open == 0

# The note in Preferences > Saving & Layouts says so.
click "Preferences##palette.preferences"
click "Saving & Layouts##preferences.config"
expect_text "the layout save themselves"
shot preferences_note
key escape

# The backups rotate: a start whose ui.json has other layouts than ui.prev.json keeps both ui.prev.json and ui.prev2.json.
restart
wait 0.2
click "##rightdivider"
wait_value layout_autosaved == 1 6
restart
wait 0.2
expect_value ui_prev_file == 1
expect_value ui_prev2_file == 1

# A ui.json from before the autosave (only "layout"): that layout is both the one in use and the saved one.
restart data/prefs/ui_empty_shelves.json
wait 0.2
expect_value shelf_has_view.wire == 1
click "##rightdivider"
expect_value right_tray_open == 0
action config.restore_custom
wait 0.3
expect_status "Saved layout restored"
expect_value right_tray_open == 1
expect_value shelf_has_view.wire == 1
