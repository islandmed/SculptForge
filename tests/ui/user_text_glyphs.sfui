# Text people type (a Part's name here) in characters the bundled fonts lack: 鬱龘 (rare Han) and 𠀋 (U+2000B, past
# the BMP) come from another font instead of drawing as "?" (src/app/UserGlyphs.h). The app takes them from the
# system's fonts; the test gives it a three-character cut of Noto Sans CJK JP so every machine draws the same.
env SF_FALLBACK_FONTS $SCRIPT_DIR/../data/fonts/cjk-fallback-test.otf
run ui_look look=classic layout=classic
run new_sphere subdivisions=2 ; part_rename to=Body
wait 0.1
expect "Parts/Body"
expect_value glyphs_merged == 0                 # nothing looked up or loaded while no such text is drawn
expect_value glyphs_missing == 0

run part_rename to=鬱龘𠀋
wait 0.2
expect "Parts/鬱龘𠀋"
expect_value glyphs_merged == 3
expect_value glyphs_missing == 0
shot en-1x

display_scale 200                               # HiDPI: the atlas is built again at 2x, with them
wait 0.2
expect_value ui_scale == 200
expect_value glyphs_missing == 0
shot en-hidpi
display_scale 100
wait 0.2

# Simplified Chinese: the interface's own glyphs come from the bundled cut, the name's from the other font.
click "Preferences##palette.preferences"
click "Interface##preferences.interface"
click "简体中文##language.zh-CN"
expect "偏好设置##palette.preferences"
key escape
wait 0.2
expect "Parts/鬱龘𠀋"
expect_value glyphs_missing == 0
shot zh-cn-1x
display_scale 200
wait 0.2
expect_value glyphs_missing == 0
shot zh-cn-hidpi
