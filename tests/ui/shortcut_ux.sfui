# Preferences > Hotkeys: a key another action uses asks first (Replace / Cancel, the popup clear of its button; Esc and
# Cancel close only the popup, the Preferences menu stays), a changed shortcut resets on its own, and Ctrl+Numpad 4 / 6 /
# 8 / 2 pan the view while held (Requested by Artizmo on Discord).
run ui_look look=classic layout=classic
run new_sphere subdivisions=3
expect_value shortcut_conflicts == 0
expect_value shortcut_conflict_open == 0

# --- Held pan keys: a hold eases in and glides, release eases out and stops (also when the window loses focus mid-hold) ---
camera 0 0
remember camera_pan p0
key_down ctrl+numpad6
wait 0.2
remember camera_pan p1
expect_value camera_pan != $p0
wait 0.6
remember camera_pan p2
expect_value camera_pan != $p1
key_up ctrl+numpad6
wait 0.2
remember camera_pan p3
wait 0.5
expect_value camera_pan == $p3
# Speed: the same hold at 4x goes further than at 1x.
key f
key_nav_speed 1
key_down ctrl+numpad4
wait 1.0
key_up ctrl+numpad4
remember camera_pan slow
key f
key_nav_speed 4
key_down ctrl+numpad4
wait 1.0
key_up ctrl+numpad4
expect_value camera_pan > $slow*1.5
key_nav_speed 1
key f
# Focus lost mid-hold: it stops.
key_down ctrl+numpad8
wait 0.6
window_focus 0
wait 0.2
remember camera_pan f1
wait 0.5
expect_value camera_pan == $f1
window_focus 1
key_up ctrl+numpad8
key f
expect_value camera_pan == 0

# --- The warning ---
click "Preferences##palette.preferences"
click "Hotkeys##preferences.hotkeys"
type "##hotkeys_filter" "Pan "
click "Ctrl+Numpad 4##hk.view.pan_left"
key ctrl+numpad6
expect_value shortcut_conflict_open == 1
expect_value shortcut_popup_overlaps_anchor == 0
shot shortcut_conflict
# Esc cancels: only the popup closes, the Hotkeys list stays, both keys unchanged.
key escape
expect_value shortcut_conflict_open == 0
expect_value shortcut_conflicts == 0
shot shortcut_after_esc
click "Ctrl+Numpad 4##hk.view.pan_left"
key ctrl+numpad6
expect_value shortcut_conflict_open == 1
# Cancel the same way.
click "Cancel##shortcut_cancel"
expect_value shortcut_conflict_open == 0
shot shortcut_after_cancel
# Replace takes it from Pan right; the reset arrow gives Pan left its own key back.
click "Ctrl+Numpad 4##hk.view.pan_left"
key ctrl+numpad6
expect_value shortcut_popup_overlaps_anchor == 0
click "Replace##shortcut_replace"
expect_value shortcut_conflict_open == 0
expect_value shortcut_conflicts == 0
shot shortcut_replaced
click "##hkreset.view.pan_left"
expect_value shortcut_conflicts == 0
shot shortcut_reset

# --- Preferences > Input: the pan and zoom key speed ---
click "Input##preferences.input"
expect_value key_nav_speed == 100
shot input_key_speed
