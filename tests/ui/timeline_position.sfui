# Timeline position (#63): the Sculpt Timeline strip runs along the top of the viewport by default, away from the
# brush shelf, below the top shelf, with the axis gizmo below it; Preferences > Interface puts it back at the
# bottom, and Store Config keeps the choice.
run ui_look look=classic layout=zbrush        # written for the Classic look and the ZBrush-style palette bar and shelves
run new_sphere subdivisions=4
stroke 0.35 0.40 0.60 0.45
expect_value timeline_top == 1
expect_value timeline_y >= 0
expect_value timeline_y < 0.05
expect_value axis_gizmo_y > 0.1
shot top

# Scrubbing works at the top: drag to the start of the track.
view_drag 0.60 0.177 0.075 0.177
expect_value timeline_cursor == 0

# Preferences > Interface > Timeline position: Bottom.
click "Preferences##palette.preferences"
click "Interface##preferences.interface"
expect_text "Timeline position"
expect "Top of viewport##view.timeline_top"
click "Bottom##view.timeline_bottom"
expect_value timeline_top == 0
shot preferences-interface
key escape
expect_value timeline_y > 0.8
expect_value axis_gizmo_y < 0.1
shot bottom

# Store Config keeps it; Restore Custom UI reads it back.
key ctrl+shift+i
expect_status "UI configuration stored"
click "Preferences##palette.preferences"
click "Top of viewport##view.timeline_top"
key escape
expect_value timeline_top == 1
key f3
type "##Command palette" "restore custom"
key enter
expect_status "Custom UI restored"
expect_value timeline_top == 0
