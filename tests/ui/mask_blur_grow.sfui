# Each blur widens (Tool > Masking): consecutive Blur clicks on one mask reach further each time. At 1x (the default)
# every click blurs as it always did; at 2x three clicks reach r, 2r, 4r (a blur's reach is the square root of its
# passes: 1, 4, 16). The chain ends when the mask changes another way, after an undo, or after about 2 seconds.
run new_sphere subdivisions=5
click "Masking"
run mask_by_facing x=0 y=1 z=0 angle=60
expect_value masked > 500
remember undo_steps start

# 1x: the button and Ctrl+click on the model blur by the same small amount every time.
click "Blur##mask"
expect_value mask_blur_passes == 1
click "Blur##mask"
expect_value mask_blur_passes == 1
hold ctrl
drag_path 0.5 0.3 0.5 0.3
hold none
expect_value mask_blur_passes == 1
expect_value mask_blur_radius == 1
expect_value undo_steps == $start+3
run mask_clear
run mask_by_facing x=0 y=1 z=0 angle=60

# 2x: type it into the slider (the typing's own undo steps are counted from after it).
double_click "##maskblurgrowth"
expect_value typing == 1
type_here 2
key enter
run mask_clear
run mask_by_facing x=0 y=1 z=0 angle=60
remember undo_steps base
click "Blur##mask"
expect_value mask_blur_radius == 1
click "Blur##mask"
expect_value mask_blur_radius == 2
hold ctrl
drag_path 0.5 0.3 0.5 0.3
hold none
expect_value mask_blur_radius == 4
expect_value mask_blur_passes == 16
expect_value undo_steps == $base+3
expect_value mask_soft > 100
shot blur_grown

# Each click is its own undo step; a click after an undo starts again.
key ctrl+z
expect_value undo_steps == $base+2
click "Blur##mask"
expect_value mask_blur_radius == 1

# Another mask change (Invert) ends the chain.
click "Blur##mask"
expect_value mask_blur_radius == 2
click "Invert##mask"
click "Blur##mask"
expect_value mask_blur_radius == 1

# So does a pause of more than about 2 seconds.
click "Blur##mask"
expect_value mask_blur_radius == 2
wait_real 2.3
click "Blur##mask"
expect_value mask_blur_radius == 1
