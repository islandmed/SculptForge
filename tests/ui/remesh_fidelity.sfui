# Voxel Remesh keeps the sculpt (#193): overlapping Clay strokes on a dynamic-topology sphere, then a Voxel Remesh at the
# default resolution. The surface stays closed, its volume and size barely move, and the stroked area keeps its smooth
# shading (no grain): the shots before and after are what the review looks at.
run ui_look look=classic layout=classic
run new_sphere subdivisions=6
camera 0 0
key f
wait 0.3
run dyntopo enabled=true detail=50
click "Clay##brush.clay"
brush_size 70
drag_path 0.44 0.50 0.50 0.52 0.56 0.50 S=0.7
drag_path 0.42 0.54 0.50 0.56 0.58 0.54 S=0.5
brush_size 45
drag_path 0.45 0.52 0.55 0.52 S=0.25
drag_path 0.46 0.56 0.54 0.48 S=0.12
drag_path 0.54 0.56 0.46 0.48 S=0.12
brush_size 90
drag_path 0.40 0.48 0.50 0.60 0.60 0.48 S=1.0
run dyntopo enabled=false
expect_value open_edges == 0
zoom 2.2
wait 0.3
hover_window 0.97 0.5
wait 0.3
shot a-before
print triangles
print solid_volume
run remesh resolution=200
wait_idle 60
print triangles
print solid_volume
expect_value open_edges == 0
wait 0.3
hover_window 0.97 0.5
wait 0.3
shot b-after
