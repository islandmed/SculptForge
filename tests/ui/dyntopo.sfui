# Dynamic topology (ZBrush's Sculptris Pro): the top shelf's Dynamic toggle and its Detail slider, strokes that
# add triangles where they go (mirrored with X symmetry), the wireframe of the remeshed area, Undo / Redo, the
# dyntopo command, and the refusal on a mesh with subdivision levels.
run new_sphere subdivisions=3
expect_value dynamic == 0
expect "Dynamic##draw.dynamic"
expect_not "##dyntopo_detail"
hold ctrl
hover "Dynamic##draw.dynamic"
expect_help "Sculptris Pro"
expect_help "subdivision levels"
hold none

click "Dynamic##draw.dynamic"
expect_value dynamic == 1
expect_status "Dynamic topology on"
expect "##dyntopo_detail"
expect_text "Detail 50"
remember triangles before
click "Standard##brush.standard"
stroke 0.3 0.35 0.7 0.55
expect_value triangles > $before*1.3
expect_value can_undo == 1
shot stroke
click "Wire##view.polyf"
expect_value wireframe == 1
shot wireframe

# Snake Hook pulls a horn out of the sphere, with new triangles all along it.
remember triangles pulled
click "Tendril##brush.snakehook"
stroke 0.62 0.3 0.95 0.05
expect_value triangles > $pulled
shot snake_hook
click "Wire##view.polyf"
shot snake_hook_shaded

# Undo takes the strokes back exactly, Redo brings them again.
key ctrl+z
key ctrl+z
expect_value triangles == $before
key ctrl+shift+z
expect_value triangles > $before*1.3
shot redo

# Finer detail: the next stroke makes smaller triangles (more of them).
run dyntopo detail=90
expect_value dynamic_detail == 90
expect_text "Detail 90"
remember triangles fine
click "Clay##brush.clay"
stroke 0.25 0.7 0.5 0.75
expect_value triangles > $fine*1.2
click "Wire##view.polyf"
shot fine_detail
click "Wire##view.polyf"

# Off: strokes leave the triangles alone.
click "Dynamic##draw.dynamic"
expect_value dynamic == 0
expect_not "##dyntopo_detail"
remember triangles off
stroke 0.4 0.4 0.6 0.6
expect_value triangles == $off

# A mesh with subdivision levels can't be remeshed: Dynamic stays off and says why.
run new_sphere subdivisions=2
run subdiv_divide
click "Dynamic##draw.dynamic"
expect_value dynamic == 0
expect_status "subdivision levels"
run subdiv_delete_lower
click "Dynamic##draw.dynamic"
expect_value dynamic == 1
