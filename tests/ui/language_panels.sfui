# The newest panels in Spanish, Traditional and Simplified Chinese (tools/i18n/coverage.py keeps every table at 100%): Preferences >
# Input, the Help menu, Tool > Remesh with Quick Remesh, the UV Editor's Pack and the VDM brush's rotation, translated and laid out without
# clipping. The "##" ids stay, so the same items are found in every language.
run ui_look look=forge scheme=neutral layout=sculptforge
drop ../../assets/demo/lion-head.glb
wait_idle 60

# Español
click "Edit##menu.edit"
click "Preferences##section.preferences"
click "Interface##preferences.interface"
click "Español##language.es"
expect_text "Idioma"
click "Entrada##preferences.input"
expect_text "Teclas clásicas de escultura"
shot es-preferences-input
key escape
click "Ayuda##menu.help"
expect "Tu primera escultura (10 min)##help.first_sculpt"
expect "Recorrido rápido##help.quick_tour"
shot es-help-menu
key escape
run ui_look layout=classic
click "Geometría##tool.geometry"
click "Remallado##tool.remesh"
expect "Remallado rápido##remesh.quick"
expect "Remallar tras cada trazo##remesh.after_stroke"
shot es-remesh
click "Remallado##tool.remesh"
key alt+u
expect_value uv_editor_open == 1
run uv_unwrap
wait_idle 120
run uv_pack columns=4 rows=3 margin=6
expect_text "Columnas"
expect_text "Densidad de téxeles"
shot es-uv-editor
key alt+u
expect_value uv_editor_open == 0
click "Pincel##palette.brush"
click "Desplazamiento vectorial##brush.vdm"
click "Horn##vdm0"
expect "Seguir la dirección del trazo##vdm.follow_stroke"
expect_text "Variación de ángulo"
shot es-vdm-rotation
key escape

# 繁體中文
run ui_look layout=sculptforge
click "Editar##menu.edit"
click "Preferencias##section.preferences"
click "Interfaz##preferences.interface"
click "繁體中文##language.zh-TW"
expect_text "語言"
click "輸入##preferences.input"
expect_text "經典雕刻按鍵"
shot zh-preferences-input
key escape
click "說明##menu.help"
expect "你的第一件雕刻（10 分鐘）##help.first_sculpt"
expect "快速導覽##help.quick_tour"
shot zh-help-menu
key escape
run ui_look layout=classic
click "幾何##tool.geometry"
click "重新網格化##tool.remesh"
expect "Quick Remesh##remesh.quick"
expect "每筆畫後重新網格化##remesh.after_stroke"
shot zh-remesh
click "重新網格化##tool.remesh"
key alt+u
expect_value uv_editor_open == 1
run uv_pack columns=4 rows=3 margin=6
expect_text "欄數"
expect_text "紋素密度"
shot zh-uv-editor
key alt+u
click "筆刷##palette.brush"
click "Horn##vdm0"
expect "跟隨筆畫方向##vdm.follow_stroke"
expect_text "角度抖動"
shot zh-vdm-rotation
key escape

# 简体中文: the same panels, mainland terms, the SC glyphs (the fonts are built again on the switch).
run ui_look layout=sculptforge
click "編輯##menu.edit"
click "偏好設定##section.preferences"
click "界面##preferences.interface"
click "简体中文##language.zh-CN"
expect_text "语言"
shot zh-hans-preferences-interface
click "输入##preferences.input"
expect_text "经典雕刻按键"
shot zh-hans-preferences-input
key escape
click "帮助##menu.help"
expect "你的第一个雕刻作品（10 分钟）##help.first_sculpt"
expect "快速导览##help.quick_tour"
shot zh-hans-help-menu
key escape
click "文件##menu.file"
shot zh-hans-file-menu
key escape
run ui_look layout=classic
shot zh-hans-geometry
click "重新网格化##tool.remesh"
expect "Quick Remesh##remesh.quick"
expect "每笔触后重新网格化##remesh.after_stroke"
shot zh-hans-remesh
click "重新网格化##tool.remesh"
key alt+u
expect_value uv_editor_open == 1
run uv_pack columns=4 rows=3 margin=6
expect_text "列数"
expect_text "纹素密度"
shot zh-hans-uv-editor
key alt+u
click "笔刷##palette.brush"
click "Horn##vdm0"
expect "跟随笔触方向##vdm.follow_stroke"
expect_text "角度抖动"
shot zh-hans-vdm-rotation
key escape

# Back to English: the same items with their English labels.
run ui_look layout=sculptforge
click "编辑##menu.edit"
click "偏好设置##section.preferences"
click "界面##preferences.interface"
click "English##language.en"
expect_text "Language"
key escape
