# The orientation widget (Draw > Camera > Corner gizmo > Orientation; a member's request): a small cube in the canvas
# corner that turns with the view. A click on a face, edge or corner turns the camera there with a short eased move
# (faces end orthographic, as the numpad views), a second click on the facing face turns to the opposite one, a drag
# orbits, a double-click frames the model. The SculptForge layout shows it by default, the Classic layout keeps the
# axes; the preference picks either or hides the corner. Shots: hover looks, views, light background, UI scale 200.
run ui_look look=classic layout=classic
run new_sphere subdivisions=4
key f
expect_value orientation_widget == 0        # Classic: the axes, as before
expect_value corner_gizmo == 1
expect_value axis_gizmo_length == 34
run ui_look look=forge layout=sculptforge
expect_value orientation_widget == 1        # SculptForge: the widget
expect_value corner_gizmo == 2
expect_value axis_view == 2
shot front_dark_100

# Hover: a face, an edge, a corner and the disc beside the cube each light up in their own way.
nav_hover front
expect_value nav_hover == 1
shot hover_front
nav_hover +x+z
expect_value nav_hover == 2
shot hover_edge
nav_hover +x+y+z
expect_value nav_hover == 3
shot hover_corner
nav_hover disc
expect_value nav_hover == 0
shot hover_disc

# A click on the edge between the front and the right faces: the camera eases to yaw 45 (a few frames in, it is on
# its way), stays in perspective (an edge view is a turned view).
nav_click +x+z
expect_value camera_moving == 1
expect_value camera_yaw > 0
expect_value camera_yaw < 45
wait 0.5
expect_value camera_moving == 0
expect_value camera_yaw == 45
expect_value camera_pitch == 0
expect_value camera_ortho == 0
shot edge_view

# A corner from a three-quarter view: yaw 45, pitch -35.26 (looking down from above the front right).
camera 35 -25
nav_click +x+y+z
wait 0.5
expect_value camera_yaw == 45
expect_value camera_pitch > -35.3
expect_value camera_pitch < -35.2
expect_value camera_aligned == 0
shot corner_view

# A face: the front, orthographic once the move ends, named under the disc.
nav_click front
expect_value camera_moving == 1
wait 0.5
expect_value camera_yaw == 0
expect_value camera_pitch == 0
expect_value camera_ortho == 1
expect_value axis_view == 2
shot front_after_click

# The front again while it faces you: the back.
nav_click front
wait 0.5
expect_value axis_view == 5
expect_value camera_yaw == 180
expect_value camera_ortho == 1

# The top from a three-quarter view (the `camera` verb sets the angles directly, so the auto-ortho stays until a turn).
camera 35 -25
nav_click top
wait 0.5
expect_value camera_pitch == -90
expect_value camera_yaw == 0
expect_value axis_view == 1
shot top_view

# A drag on the cube orbits instead of clicking: the view leaves the side view, no eased move runs.
nav_drag 40 0
expect_value camera_moving == 0
expect_value camera_aligned == 0
expect_value axis_view == -1
shot after_drag

# A double-click frames, and only frames: zoom far out first, then the model fills the view again and the view is
# back where it was (the first click's turn is undone).
camera 35 -25
camera_distance 40
nav_double_click +x+y+z
wait 0.6
expect_value camera_distance < 10
expect_value camera_moving == 0
expect_value camera_yaw == 35
expect_value camera_pitch == -25

# Orbit lock: the locked axis runs through the disc and its badge sits at the lower right, with the widget too.
action view.orbit_lock_x
camera 35 -25
shot orbit_lock_x
action view.orbit_lock_free

# Reduce motion: a click lands at once.
click "Edit##menu.edit"
click "Preferences##section.preferences"
click "Interface##preferences.interface"
click "Reduce motion"
expect_value reduce_motion == 1
key escape
camera 35 -25
nav_click right
expect_value camera_moving == 0
expect_value camera_yaw == 90
expect_value camera_ortho == 1

# The preference: the axes instead, hidden, and the widget again (Draw > Camera > Corner gizmo).
camera 35 -25
action view.corner_axes
expect_value corner_gizmo == 1
expect_value orientation_widget == 0
shot axes_instead
action view.corner_off
expect_value corner_gizmo == 0
nav_click front
expect_value camera_moving == 0             # nothing there to click: a plain click on the background
expect_value camera_yaw > 34.9
expect_value camera_yaw < 35.1
action view.corner_widget
expect_value corner_gizmo == 2

# A light background: the glass darkens, the names stay readable; and UI scale 200.
run set_background color=215,215,218
camera 35 -25
shot three_quarter_light_100
nav_hover +x+y+z
shot three_quarter_light_hover_corner
ui_scale 200
expect_value ui_scale == 200
camera 35 -25
shot three_quarter_light_200
nav_hover front
shot three_quarter_light_200_hover_front
