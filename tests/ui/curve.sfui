# Curve Part and the Tube modifiers (Tool > Tube, PanelTube.cpp; requested by Hameron, GABO and Artizmo): draw a
# curve on and over the model, Resample it to an exact point count, Tube from curve, then the Rope, Braid and Sleeve
# profiles with Twist, Spin and Spread. The shots feed the guide's Tube chapter.
run ui_look look=classic layout=classic
wait 0.3
click "Tube##tool.tube"
click "Tube/Draw Tube"
click "Tube/Curve"
drag_path 0.3 0.4 0.55 0.2 0.8 0.45 1.05 0.25 1.3 0.5 S=1.2
wait 0.2
expect_value tube_parts == 1
expect_status "Added Curve Part"
run part_select index=1
expect_value tube_curve == 1
expect_value open_edges == 0
shot curve
run tube_resample count=12
expect_value tube_points == 12
expect_status "Resampled"
shot resample
ui_scale 200
wait 0.3
shot resample-200
ui_scale 100
wait 0.3
key ctrl+z
expect_value tube_points >= 3
# Tube from curve: the Tube tool's sweep with the profile chosen; the curve comes back with undo.
click "Tube/Rope"
click "Tube/Tube from curve"
expect_value tube_curve == 0
expect_value tube_profile == 4
expect_status "Tube from curve"
shot rope
run tube_set twist=180 spread=0.7
expect_value tube_twist == 180
shot rope-twist
click "Tube/Braid"
expect_value tube_profile == 5
shot braid
click "Tube/Sleeve"
expect_value tube_profile == 6
expect_value open_edges == 0
shot sleeve
ui_scale 200
wait 0.3
shot sleeve-200
ui_scale 100
wait 0.3
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
expect_value tube_curve == 1
