# Help > What's New opens the guide's What's New chapter (it also opens by itself once after an update).
run new_sphere subdivisions=3
click "Help##palette.help"
click "What's New##help.whats_new"
expect_value guide_open == 1
expect_guide whats-new.md
expect_text "Version 0.10.5"
expect_text "Morph to Set"
expect_text "Version 0.10.4"
expect_text "Version 0.10.3"
expect_text "Version 0.10.2"
expect_text "Version 0.9.6"
expect_text "Extract"
expect_text "Version 0.9.5"
expect_text "Version 0.9.4"
expect_text "Version 0.9.3"
expect_text "Version 0.9.2"
expect_text "Version 0.9.1"
expect_text "Version 0.9.0"
expect_text "Version 0.8.1"
expect_text "Version 0.8"
expect_text "Version 0.7"
expect_text "Version 0.6"
expect_text "Version 0.5"
expect_text "Version 0.4.2"
# The newest section is on screen.
expect_text "Selection sets"
shot whats-new

# The end of the chapter: a quiet line about supporting SculptForge; its button only asks for the website's page
# (UI tests never start a browser).
expect_text "If it helps your work, you can support its development."
expect "Support SculptForge##whats_new"
expect_value support_requests == 0
