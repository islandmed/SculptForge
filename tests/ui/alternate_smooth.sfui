# Alternate smooth (#40, ZBrush): a stroke begun with Shift held smooths plainly (the sphere shrinks under it);
# letting go of Shift while still pressing switches to the smooth that keeps the volume for the rest of the
# stroke. Brush > Smooth keeps volume makes that the Shift smooth, and letting go then switches to the plain one.
run ui_look look=classic layout=zbrush        # written for the Classic look and the ZBrush-style palette bar and shelves
run new_sphere subdivisions=5
expect_value smooth_keep_volume == 0
snapshot

# Shift held all along: the plain smooth pulls the surface in.
hold shift
drag_path 0.3 0.35 0.35 0.35 keep
expect_value stroking == 1
expect_value stroke_keep_volume == 0
drag_path 0.35 0.35 0.7 0.35 0.7 0.65 0.3 0.65 0.3 0.4 keep
expect_value stroke_keep_volume == 0
release
hold none
expect_value moved_out < 0
remember moved_out plain
expect_value can_undo == 1
key ctrl+z
expect_value moved == 0

# The same stroke, letting go of Shift just after it starts: the rest keeps the volume.
hold shift
drag_path 0.3 0.35 0.35 0.35 keep
expect_value stroke_keep_volume == 0
hold none
drag_path 0.35 0.35 0.7 0.35 0.7 0.65 0.3 0.65 0.3 0.4 keep
expect_value stroking == 1
expect_value stroke_keep_volume == 1
expect_status keeping volume
release
expect_value moved > 100
expect_value moved_out > $plain*0.3
remember moved_out alternate
key ctrl+z
expect_value moved == 0
# The next stroke starts plain again.
hold shift
drag_path 0.3 0.35 0.35 0.35 keep
expect_value stroke_keep_volume == 0
release
hold none
key ctrl+z

# Brush > Smooth keeps volume: Shift smooths keeping the volume, and letting go of Shift switches to the plain one.
click "Brush##palette.brush"
click "Brush/##totray"
wait 0.3
hold ctrl
hover "Smooth keeps volume##smooth_keep_volume"
expect_help without shrinking
hold none
click "Smooth keeps volume##smooth_keep_volume"
expect_value smooth_keep_volume == 1
hold shift
drag_path 0.3 0.35 0.35 0.35 keep
drag_path 0.35 0.35 0.7 0.35 0.7 0.65 0.3 0.65 0.3 0.4 keep
expect_value stroke_keep_volume == 1
release
hold none
expect_value moved_out > $plain*0.3
key ctrl+z
hold shift
drag_path 0.3 0.35 0.35 0.35 keep
hold none
drag_path 0.35 0.35 0.7 0.35 0.7 0.65 0.3 0.65 0.3 0.4 keep
expect_value stroke_keep_volume == 0
release
expect_value moved_out < $alternate
key ctrl+z
click "Smooth keeps volume##smooth_keep_volume"
expect_value smooth_keep_volume == 0
