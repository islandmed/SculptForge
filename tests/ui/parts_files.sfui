# Parts survive files: build a scene in the UI, save a project, reopen it, and round-trip GLB / OBJ.
# Files are written to the working directory (the build folder under ctest).
run new_sphere subdivisions=4
click "Parts/Append"
click "Cube"
click "Parts/Append"
click "Sphere"
expect_value parts == 3
double_click "Parts/Sphere 2"
type "##rename" Eye
key enter
expect_text Eye
click "Parts/Cube"
stroke 0.4 0.4 0.6 0.6
expect_value edited_parts == 1
click "Parts/##eye Eye"
expect_value visible_parts == 2
shot before-save

run save_project path=sf_ui_parts.sfproj
run new_sphere subdivisions=2
expect_value parts == 1
run open path=sf_ui_parts.sfproj
expect_value parts == 3
expect_value visible_parts == 2
expect_value active_part == 1
expect_value dirty == 0
expect_text Eye
shot reopened

# Exports carry the visible Parts only; opening the export gives them back as Parts.
run export_glb path=sf_ui_parts.glb
run open path=sf_ui_parts.glb
expect_value parts == 2
run save_obj path=sf_ui_parts.obj
run open path=sf_ui_parts.obj
expect_value parts == 2
shot obj-reopened
