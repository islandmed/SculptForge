# Forge Spheres with the pointer only (#8): Drag places child makes one Draw drag grow a new sphere and move it away
# from its parent (Ctrl+drag does the same with it off), the new sphere is selected, Delete Selected / Insert Between /
# Set as Root work on it, and a right click on a sphere opens a menu with the same (a right drag still turns the
# view). Symmetry X is on, so arms come in pairs.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run forgesphere_new radius=1
run part_visibility index=0 visible=false
wait 0.3
click "Forge Spheres##tool.forgespheres"
expect "Forge Spheres/Drag places child"
hold ctrl
hover "Forge Spheres/Drag places child"
expect_help "grows a new sphere"
hover "Forge Spheres/Delete Selected"
expect_help "selected sphere"
hold none

# Off (the default): a Draw click adds a new sphere on the parent's surface, about one radius out.
expect_value forgesphere_place_child == 0
drag_forgesphere 0 rim 0 0 0.05
expect_value forgespheres == 3
expect_value forgesphere_out1 < 1.05
expect_value forgesphere_selected == 1
key ctrl+z
expect_value forgespheres == 1

# On: a drag pulls a new sphere out, at half the parent's size.
click "Forge Spheres/Drag places child"
expect_value forgesphere_place_child == 1
drag_forgesphere 0 rim 120 0
expect_value forgespheres == 3
expect_value forgesphere_out1 > 1.4
expect_value forgesphere_r1 == 0.5
expect_value forgesphere_x2 < -1.0
expect_status "Forge Sphere add"
expect_value forgesphere_selected == 1
shot placed
key ctrl+z
click "Forge Spheres/Drag places child"
expect_value forgesphere_place_child == 0

# Ctrl+drag places too, with the toggle off.
hold ctrl
drag_forgesphere 0 rim 120 0
hold none
expect_value forgespheres == 3
expect_value forgesphere_out1 > 1.4

# Insert Between on the selected arm: a joint (and its mirror), selected.
click "Forge Spheres/Insert Between"
expect_value forgespheres == 5
expect_status "Forge Sphere insert"
expect_value forgesphere_selected == 3

# Delete Selected: the joint and the arm beyond it go (both sides); the root stays.
click "Forge Spheres/Delete Selected"
expect_value forgespheres == 1
expect_value forgesphere_selected == -1
key ctrl+z
expect_value forgespheres == 5

# A right drag on a sphere still turns the view and opens nothing.
remember camera_yaw yaw
drag_forgesphere 0 body 80 0 0.4 right
expect_value forgesphere_menu == 0
expect_value camera_yaw != $yaw
camera 0 0
wait 0.1

# A right click on the arm: its menu. Set as Root makes it the root (index 0), one undo step.
remember forgesphere_root_x rootx
drag_forgesphere 1 body 0 0 0.05 right
expect_value forgesphere_menu == 1
expect "Forge Sphere menu/Set as Root"
shot menu
click "Forge Sphere menu/Set as Root"
expect_value forgesphere_menu == 0
expect_value forgesphere_root_x > 1.0
expect_value forgespheres == 5
expect_status "set root"
key ctrl+z
expect_value forgesphere_root_x == $rootx

# The root's own menu can't delete it.
drag_forgesphere 0 body 0 0 0.05 right
expect_value forgesphere_menu == 1
click "Forge Sphere menu/Delete Sphere"
expect_value forgespheres == 5
key escape
