# Help > Check for updates: a newer version shows the banner (Skip this version hides it), the same or an older one
# says SculptForge is up to date, and a feed that can't be read says so. The feed is a local file here
# (SF_UPDATE_FEED); UI tests never check automatically.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=3
env SF_UPDATE_FEED $SCRIPT_DIR/data/update_newer.json
click "Help##palette.help"
click "Check for updates##help.check_updates"
wait_idle 20
expect_text "SculptForge 99.0.0 is available"
expect_text "bug-fix and security releases go out to everyone the same day"
expect "Become a member"
expect_text "Members get betas early."
expect_text "Twice as fast"
expect "Download"
shot update-banner
click "Skip this version"
expect_not "Skip this version"

env SF_UPDATE_FEED $SCRIPT_DIR/data/update_older.json
click "Help##palette.help"
click "Check for updates##help.check_updates"
wait_idle 20
expect_status "is the newest version"
expect_not "Skip this version"

env SF_UPDATE_FEED $SCRIPT_DIR/data/no_such_feed.json
click "Help##palette.help"
click "Check for updates##help.check_updates"
wait_idle 20
expect_status "Couldn't check for updates"

# The Preview channel (Preferences > Updates > Update channel) is offered the feed's channels.preview beta; Stable
# isn't. Back to Stable at the end (the choice is saved in the preferences).
# (A beta build starts on Preview, so pick Stable first.)
env SF_UPDATE_FEED $SCRIPT_DIR/data/update_preview.json
click "Preferences##palette.preferences"
click "Updates##preferences.updates"
expect_text "Update channel"
click "Stable##prefs.update_stable"
click "Check for updates##help.check_updates"
wait_idle 20
expect_status "is the newest version"
click "Preview (betas)##prefs.update_preview"
shot update-channel
click "Check for updates##help.check_updates"
wait_idle 20
expect_text "SculptForge 99.0.0-beta.1 is available"
expect_text "Try the beta"
shot update-banner-beta
# The banner stays above the Preferences menu, its buttons in sight: the first click outside the menu closes it (as
# for any menu), the next one is Later's.
click "Later"
expect_not "Update channel"
click "Later"
expect_not "Skip this version"
click "Preferences##palette.preferences"
expect_text "Update channel"
click "Stable##prefs.update_stable"
