# The renamed Tool sub-palettes (fix/ip-palettes) below 1280 px, where the Tool palette opens as a drop-down (F3
# opens it). CMake runs this at 1024x768; shots at 100% and 200%.
run new_sphere subdivisions=3
key f3
type "##Command palette" "Tool"
click "Tool##pal.ui.palette.tool"
wait 0.3
expect "Reshape##tool.deformation"
expect "Viewport Look##tool.display"
shot tool-list-narrow-100
click "Reshape##tool.deformation"
wait 0.3
expect "Reshape/Smooth"
expect "Reshape/Balloon"
shot reshape-narrow-100
ui_scale 200
wait 0.3
shot reshape-narrow-200
ui_scale 100
click "Reshape##tool.deformation"
click "Geometry##tool.geometry"
wait 0.3
expect "Symmetry/Mirror"
button_drag middle 0.65 0.85 0.65 0.15 0.3
button_drag middle 0.65 0.85 0.65 0.15 0.3
shot geometry-symmetry-narrow-100
