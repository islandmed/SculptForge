# Tool > Geometry's groups (fix/ip-labels) below 1280 px, where the Tool palette opens as a drop-down (F3 opens it).
# CMake runs this at 1024x768; shots at 100% and 200%.
run new_sphere subdivisions=3
key ctrl+d
key f3
type "##Command palette" "Tool"
click "Tool##pal.ui.palette.tool"
wait 0.3
click "Geometry##tool.geometry"
wait 0.3
expect "Geometry/Add Level"
expect "Geometry/Smooth"
expect "Geometry/Remove Below"
expect_text "Levels"
mouse_leave
wait 0.2
shot geometry-narrow-100
ui_scale 200
wait 0.3
shot geometry-narrow-200
ui_scale 100
