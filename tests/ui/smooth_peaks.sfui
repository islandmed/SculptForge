# Smooth Peaks (a member idea): a smooth that only lowers the high points. A bumpy stroke, then Smooth Peaks over it:
# the bumps come down, nothing rises, and the plain Smooth still fills hollows. The B pop-up lists the new brush.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=6
wait_idle 30
camera 0 0
key x
expect_value symmetry_x == 0

action brush.standard
expect_value brush_type == 0
stroke 0.3 0.5 0.7 0.5
wait_idle 30
shot bumps

key b
wait 0.2
expect "Smooth Peaks"
shot picker
key escape

action brush.smoothpeaks
expect_value brush_type == 22
snapshot
stroke 0.3 0.5 0.7 0.5
stroke 0.3 0.5 0.7 0.5
stroke 0.3 0.5 0.7 0.5
expect_value moved > 100
expect_value moved_out < 0
wait_idle 30
shot peaks_lowered
key ctrl+z
key ctrl+z
key ctrl+z
expect_value moved == 0
