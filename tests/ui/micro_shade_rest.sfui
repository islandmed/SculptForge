# gh#184 follow-up: a big stroke's release leaves its shading to drain over frames (it no longer shades the whole backlog
# in the release frame, which doubled peak RAM on big levels). Without Focus Detail (the only path Windows and macOS
# have) nothing kept the frames coming once the input stopped: stale patches stayed until the mouse moved. With no focus
# and no pointer after the release the app must keep drawing until the backlog is shaded, show it whole, then rest.
# (SF_SHADE_BUDGET_POINTS makes the backlog outlast the frames after the last input; cold: env is set here.)
run ui_look look=classic layout=classic
env SF_FOCUS_DETAIL 0
run new_sphere subdivisions=6
run micro_divide level=4
wait_idle 120
camera 0 0
key f
wait_idle 30

click "Clay##brush.clay"
brush_size 120
env SF_SHADE_BUDGET_POINTS 2000
stroke 0.15 0.30 0.85 0.70 0.8
stroke 0.15 0.70 0.85 0.30 0.8
window_focus 0
mouse_leave
# (past the frames any input keeps drawing: 0.75 s)
wait_real 1.5
expect_value focus_frames == 0
expect_value micro_pending_shading > 0
expect_value wants_frames == 1
env SF_SHADE_BUDGET_POINTS 0
wait_value micro_pending_shading == 0 60
expect_value view_stale < 0.02
# Shaded: nothing runs, the app rests.
wait_real 1.5
expect_value wants_frames == 0
window_focus 1
