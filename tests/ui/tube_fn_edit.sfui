# Tube functional pass: edit points (move, resize, radius slider, insert, delete), ends, symmetry, undo/redo.
run ui_look look=classic layout=classic
wait 0.3
click "Tube##tool.tube"
click "Tube/Draw Tube"
drag_path 0.3 0.4 0.55 0.2 0.8 0.45 1.05 0.25 1.3 0.5 S=1.2
wait 0.2
expect_value tube_parts == 1
hold shift                                     # (Draw Tube is on: Shift grabs a dot)
drag_tube_point 2 0 -60
hold none
expect_value active_part == 1
expect_status "point moved"
remember triangles moved
hold ctrl
drag_tube_point 2 80 0
hold none
expect_status "point size"
expect_value open_edges == 0
drag_item "Tube/##tubepointr" 60 0
wait 0.2
expect_status "Tube point"
shot radius-slider
key ctrl+z
key ctrl+z
expect_status "Undo"
key ctrl+z
expect_status "Undo"
run redo
expect_status "Redo"
click "Tube/Insert Point"
expect_value open_edges == 0
click "Tube/Delete Point"
hold alt
drag_tube_point 0 0 0
hold none
expect_status "Tube delete point"
click "Tube/Flat"
expect_value open_edges == 0
click "Tube/Rounded"
# Symmetry X (on by default): a mirrored stroke, then editing keeps the copy.
run part_select index=0
expect_value symmetry_x == 1
drag_path 0.55 0.3 0.7 0.25 0.85 0.35 S=0.6
wait 0.2
expect_value tube_parts == 2
run part_select index=2
remember triangles mirrored
expect_value open_edges == 0
shot symmetry
hold shift                                     # (Draw Tube is on: Shift grabs a dot)
drag_tube_point 1 0 -40
hold none
expect_status "point moved"
expect_value triangles > 0                    # (ring count follows the new length)
expect_value open_edges == 0
shot symmetry-edit
key x
# Undo all the way back, then redo all the way.
run undo
run undo
run undo
run undo
run redo
run redo
run redo
run redo
expect_value tube_parts == 2
