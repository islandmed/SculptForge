# The version at a glance for support screenshots (owner 11-07): the OS window title "<document>[*] — SculptForge
# <version>" (the document first, so taskbars and Alt-Tab stay readable) and small dim text beside the name in the
# top bar, in both layouts and every bar style. {version} is the version as shown: "0.11.13", "0.12.0 beta.2" or a
# developer's "0.11.13 dev 1a2b3c4". CMake also runs this at 1440x900 and 1024x768 (the bar drops it when narrow).
expect_title Untitled — SculptForge {version}

run ui_look look=classic layout=classic
expect_text {version}
expect_value title_overlaps == 0
shot classic

run new_sphere subdivisions=3
stroke 0.4 0.45 0.6 0.55
expect_title Untitled* — SculptForge {version}

run ui_look look=classic layout=sculptforge
expect_text {version}
shot modules

run ui_look look=forge layout=sculptforge
expect_text {version}
expect_title Untitled* — SculptForge {version}
shot terminal

run ui_look look=blueprint
expect_text {version}
expect_value title_overlaps == 0
shot title_block

expect_value title_overlaps == 0

# UI scale 200% (a 1024 px window is 512 px wide then): nothing in the top bar overlaps; the version goes first, then
# the workspaces / layout presets, the search field shrinks to its icon, and the last menus move behind >>.
ui_scale 200
run ui_look look=classic layout=classic
expect_value title_overlaps == 0
shot classic_200
run ui_look look=classic layout=sculptforge
expect_value title_overlaps == 0
shot modules_200
run ui_look look=forge layout=sculptforge
expect_value title_overlaps == 0
shot terminal_200
run ui_look look=blueprint
expect_value title_overlaps == 0
shot title_block_200

# 512 logical px at any window size (a 1024 px window at 200 %): the menus that don't fit open from >>.
ui_scale auto
run ui_look look=forge layout=sculptforge
logical_width 512
wait_idle 30
expect_value title_overlaps == 0
expect_not "Help##menu.help"
click "##menu.more"
click "Help##menu.help"
expect_value dropdown_open == 1
shot more_menus_512
key escape
