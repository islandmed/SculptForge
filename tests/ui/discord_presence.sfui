# Preferences > Integrations > Show SculptForge on Discord (PanelIntegrations.cpp, core/DiscordPresence.h): off by
# default; its options wait for it; the theme is capped at 64 characters; a UI test never connects to Discord.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
expect_value discord_presence == 0
click "Preferences##palette.preferences"
click "Integrations##preferences.integrations"
expect "Show SculptForge on Discord##prefs.discord"
expect_text "Nothing else is sent"
shot discord-prefs-off

click "Show SculptForge on Discord##prefs.discord"
expect_value discord_presence == 1
click "Show the monthly challenge##prefs.discord"
type "##prefs.discord.challenge" "Sea monsters"
key enter
click "Show the file name##prefs.discord"
shot discord-prefs-on
expect_value discord_connects == 0

click "Show SculptForge on Discord##prefs.discord"
expect_value discord_presence == 0
expect_value discord_connects == 0
