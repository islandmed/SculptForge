# Preferences > Integrations > Show SculptForge on Discord (PanelIntegrations.cpp, core/DiscordPresence.h): off by
# default; the preferences spell out what is shared; the one word about the work follows the input and the tool in
# hand (Idle, Sculpting, Painting); a UI test never connects to Discord.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
expect_value discord_presence == 0
expect_value discord_mode == 0                 # Idle until a stroke
run new_sphere subdivisions=4
stroke 0.35 0.4 0.65 0.6
expect_value discord_mode == 1                 # Sculpting
action draw.paint
expect_value paint_mode == 1
expect_value discord_mode == 2                 # Painting: the Paint brush in hand
stroke 0.3 0.5 0.7 0.5
expect_value discord_mode == 2
action draw.sculpt
expect_value paint_mode == 0
expect_value discord_mode == 1                 # back to Sculpting
expect_value discord_connects == 0

click "Preferences##palette.preferences"
click "Integrations##preferences.integrations"
expect "Show SculptForge on Discord##prefs.discord"
expect_text "Nothing else"
expect_text "Sent only to the Discord app on this computer"
expect_value discord_options_note == 0         # a fresh install never had the removed options
shot discord-prefs-off

click "Show SculptForge on Discord##prefs.discord"
expect_value discord_presence == 1
shot discord-prefs-on
expect_value discord_connects == 0

click "Show SculptForge on Discord##prefs.discord"
expect_value discord_presence == 0
expect_value discord_connects == 0
