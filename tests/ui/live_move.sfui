# Live Move (Preferences > Performance, experimental): the graphics card draws a Move drag and the move is applied
# once when the pen lifts. The same drag leaves the same surface as plain Move (one grab with the whole move is the
# sum of the per-frame grabs) and undo puts it back.
run ui_look look=classic layout=zbrush        # written for the Classic look and the ZBrush-style palette bar and shelves
run new_sphere subdivisions=5
camera 0 0
click "Move##brush.move"
expect_value live_move == 0

# Plain Move.
snapshot
stroke 0.86 0.5 0.98 0.38
remember moved_sum plain
remember moved_max plainMax
expect_value moved_sum > 0
key ctrl+z
expect_value moved == 0

# Live Move on (Ctrl-hover help first).
click "Preferences##palette.preferences"
click "Performance##preferences.performance"
hold ctrl
hover "Live Move (Experimental)"
expect_help "lift the pen"
hover "Background Preview (Experimental)"
expect_help "exactly the same"
hold none
click "Live Move (Experimental)"
expect_value live_move == 1
expect_status "Live Move on"
click "Preferences##palette.preferences"

# The same drag: the same surface.
snapshot
stroke 0.86 0.5 0.98 0.38
expect_value moved_sum > $plain*0.999
expect_value moved_sum < $plain*1.001
expect_value moved_max > $plainMax*0.999
expect_value moved_max < $plainMax*1.001
shot live_move
key ctrl+z
expect_value moved == 0

# Mid-drag: the graphics card draws the move, the mesh itself hasn't moved yet; letting go applies it.
snapshot
stroke 0.86 0.5 0.98 0.38 0.6 hold
wait 0.3
expect_value moved == 0
expect_value live_move_active == 1
shot live_move_dragging
release
expect_value moved_sum > $plain*0.999
expect_value moved_sum < $plain*1.001
key ctrl+z
expect_value moved == 0

# Twice in a row, then both undone.
stroke 0.86 0.5 0.98 0.38
stroke 0.80 0.6 0.90 0.7
expect_value moved > 0
key ctrl+z
key ctrl+z
expect_value moved == 0

# Background Preview and Fast Upload: on and off again; Live Move off again.
click "Preferences##palette.preferences"                # (Performance stays open from before)
expect_value background_preview == 0
click "Background Preview (Experimental)"
expect_value background_preview == 1
click "Background Preview (Experimental)"
expect_value background_preview == 0
expect_value fast_upload == 0
click "Fast Upload (Experimental)"
expect_value fast_upload == 1
shot experimental_toggles
click "Fast Upload (Experimental)"
expect_value fast_upload == 0
click "Live Move (Experimental)"
expect_value live_move == 0
click "Preferences##palette.preferences"
