# The first-use notice for third-party AI hosts (ai/Consent.h, PanelAiConsent.cpp). A stub stands in for the service
# (generator_stub: never the network, http_requests stays 0). Generate 3D's first Generate shows, inside the panel,
# what is sent, to which host and who pays; Cancel sends nothing; Allow runs it and is remembered (no second notice);
# Preferences > AI lists it with Revoke, after which it asks again. Brush Lab's free tier asks first too. In Spanish, and at 200%
# (ai_consent_1440 / ai_consent_2880 are the review sizes).
run ui_look look=classic layout=classic
run new_sphere subdivisions=3
generator_stub sphere torus cube
drop ../../assets/demo/teddy-sketch.png
wait_for "Generate 3D/Generate 3D model" 5

click "Generate 3D/Generate 3D model"
expect_text Send to Hugging Face (Tencent)?
expect_text tencent-hunyuan3d-2-1.hf.space
expect_text this image (framed, up to 1024 px)
expect_text Free: Hugging Face's shared GPUs
expect "Allow##send"
expect "Cancel##send"
expect "Set up local##send"                      # (UI tests never look for a local server)
expect_value generate_candidates == 0
expect_value http_requests == 0
shot consent-generate

click "Cancel##send"
expect_no_text Send to Hugging Face
expect_status Nothing was sent
expect_value http_requests == 0

click "Generate 3D/Generate 3D model"
click "Allow##send"
click OK                                         # the one-time Hunyuan3D licence notice (after Allow, never before)
wait_value generate_candidates == 3 30
expect_value http_requests == 0
click "Generate 3D/Discard all##candidates"

# Remembered: the next Generate goes straight on.
click "Generate 3D/Generate 3D model"
expect_no_text Send to Hugging Face
wait_value generate_candidates == 3 30
click "Generate 3D/Discard all##candidates"

# Preferences > AI: every online service, its state, Revoke.
click "Preferences##palette.preferences"
click "AI##preferences.ai"
expect_text Online AI services
expect_text Pollinations.ai
expect_text Asks first
expect_text Allowed
shot consent-prefs
click "Revoke"
expect_status will ask again before anything is sent
expect_no_text Revoke
key escape

click "Generate 3D/Generate 3D model"
expect_text Send to Hugging Face (Tencent)?
click "Cancel##send"

# Brush Lab, the free tier: asks before the first brush, nothing goes on Cancel.
click "AI Brush"
type "Brush Lab/##prompt" bark of an old oak tree
click "Brush Lab/Create"
expect_text Send to Pollinations.ai?
expect_text text.pollinations.ai
expect_text your brush description and the current brush settings
shot consent-brush
click "Cancel##send"
expect_value http_requests == 0

# Spanish: the notice and its buttons are translated.
click "Preferences##palette.preferences"
click "Interface##preferences.interface"
click "Español##language.es"
key escape
type "Laboratorio de pinceles/##prompt" bark of an old oak tree
click "Laboratorio de pinceles/Create"
expect "Permitir##send"
expect "Cancelar##send"
expect_text ¿Enviar a Pollinations.ai?
shot consent-brush-es
ui_scale 200
wait 0.2
expect "Permitir##send"
shot consent-brush-es-200
ui_scale 100
click "Cancelar##send"
expect_value http_requests == 0

# 200% in English (the 2880 run's review shots): the notice's three buttons and the services table with Revoke.
click "Preferencias##palette.preferences"
click "AI##preferences.ai"                       # (Interface is still open from before: one section open at a time)
click "Interfaz##preferences.interface"
click "English##language.en"
key escape
ui_scale 200
wait 0.2
click "Generate 3D/Generate 3D model"
expect "Allow##send"
expect "Set up local##send"
shot consent-generate-200
click "Allow##send"                              # (the Hunyuan3D licence note was shown once already)
wait_value generate_candidates == 3 30
click "Generate 3D/Discard all##candidates"
click "Preferences##palette.preferences"
click "AI##preferences.ai"
expect_text Online AI services
expect "Revoke"
shot consent-prefs-200
key escape
ui_scale 100
expect_value http_requests == 0
generator_stub off
