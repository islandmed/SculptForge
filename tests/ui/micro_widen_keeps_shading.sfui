# gh#184 (0.13.10 freeze): the first Draw stroke on a new streamed Micro level grows the level's height range
# (MicroMesh::widen: every value divided, the same surface), and the renderer re-shaded every tile for it in one frame
# (1-2 s on a 2.6M base). Now it re-sends the heights only and keeps the shading: the view must match the same mesh
# sent up whole and shaded again (view_stale, mean pixel difference 0-255), once idle.
# cold: SF_FOCUS_DETAIL is set here, and a warm server doesn't keep it between scripts.
run ui_look look=classic layout=classic
env SF_FOCUS_DETAIL 1
run new_sphere subdivisions=7
run micro_divide level=4
env SF_FOCUS_DETAIL 0
wait_idle 120
camera 0 0
key f
wait_idle 30
remember micro_step before

click "Standard##brush.standard"
run brush_set_alpha name=Bolt
brush_size 120
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
stroke 0.35 0.45 0.65 0.55 1.0
stroke 0.35 0.55 0.65 0.45 1.0
expect_value micro_step > $before
wait_value micro_pending_coarse == 0 120 # (real time: llvmpipe takes far longer than this computer)
wait_idle 60
print view_stale
expect_value view_stale < 0.001
shot micro_widen_draw
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
key ctrl+z
wait_value micro_pending_coarse == 0 120 # (undo's own shading catches up within the budget here)
expect_value view_stale < 0.02
print view_stale
