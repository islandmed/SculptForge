# Quad retopology and detail projection: Geometry > QRemesh (QRemesh) rebuilds a sculpted sphere as
# clean quads in the background, keeping the original as a hidden Part; after dividing the retopo twice,
# Part > Project > ProjectAll brings the sculpted detail back.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=6
run stroke points="-0.6,0.35,2 0,0.55,2 0.6,0.35,2" brush=Standard radius=0.16 strength=1
run stroke points="-0.55,-0.35,2 0.55,-0.4,2" brush=Crease radius=0.12 strength=1
run stroke points="0,0.15,2 0.1,-0.1,2" brush=Clay radius=0.22 strength=1 invert=true
stroke 0.5 0.15 0.5 0.85
click "Geometry##tool.geometry"
expect "QRemesh/Quad Remesh"
expect "QRemesh/##qadaptive"
expect_value quads == 0

# Ctrl-hover help on the new controls.
hold ctrl
hover "QRemesh/Quad Remesh"
expect_help "all-quad topology"
hover "QRemesh/Follow Face Groups"
expect_help "face group borders"
hover "QRemesh/200%"
expect_help "twice"
hover "QRemesh/##qtarget"
expect_help "how many quads"
hold none

# Target Quads about 3000 (drag the slider), keep the original.
drag_item "QRemesh/##qtarget" -16 0
expect_text "Target Quads 3"
click "QRemesh/Keep Original"
remember triangles sculpt_tris
click "QRemesh/Quad Remesh"
wait_idle 120
expect_status "quads"
expect_status "100% quads"
expect_value quad_percent == 100
expect_value quads > 2400
expect_value quads < 4400
expect_value parts == 2
expect_value visible_parts == 1
click "Wire##view.wire"
shot qremesh-wire
click "Wire##view.wire"

# One undo step; redo brings the quads back.
key ctrl+z
expect_value quads == 0
expect_value triangles == $sculpt_tris
key ctrl+shift+z
expect_value quads > 2400

# 50% / 100% / 200% set the target from the current polygon count.
# (2400-4400 polygons doubled can't start with a 3, unlike the dragged target of about 3000.)
click "QRemesh/200%"
expect_text "Target Quads"
expect_no_text "Target Quads 3"

# Add two levels, show the original and project its detail back.
run subdivide levels=2
run part_visibility index=1 visible=true
click "Parts##tool.part"
expect "Project/Project Detail"
hold ctrl
hover "Project/Project Detail"
expect_help "nearest surface within Dist"
hover "Project/##pdist"
expect_help "fraction of the Part's size"
hold none
snapshot
click "Project/Project Detail"
expect_status "vertices projected"
expect_value moved > 20000
run part_visibility index=1 visible=false
click "Wire##view.wire"
shot projected-wire
click "Wire##view.wire"
shot projected
key ctrl+z
expect_value moved == 0

# Cancel: a big target on the sculpt stops part way and leaves it as it was.
run part_select index=1
run part_visibility index=1 visible=true
click "Geometry##tool.geometry"
click "QRemesh/Keep Original"
click "QRemesh/100%"
remember triangles before_cancel
click "QRemesh/Quad Remesh"
expect_value qremesh_running == 1
click "QRemesh/Cancel"
wait_idle 60
expect_status "cancelled"
expect_value triangles == $before_cancel
expect_value quads == 0

# The bundled lion bust: 47k triangles of sculpt to 5000 quads, edge loops following the mane.
drop ../../assets/demo/lion-head.glb
wait_idle 30
click "QRemesh/Keep Original"
drag_item "QRemesh/##qtarget" 6 0
expect_text "Target Quads 5"
click "QRemesh/Quad Remesh"
wait_idle 120
expect_status "100% quads"
expect_value quad_percent == 100
click "Wire##view.wire"
shot lion-qremesh-wire
