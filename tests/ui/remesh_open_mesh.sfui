# Voxel Remesh and Quick Remesh of an open Part (launch clips 11-05): the Stylised Head starter is open at the neck;
# after a Move pull near the neck both remeshes gave a thin shell full of holes. Now the neck is capped first: a
# closed head about as big as before, one undo step each.
run ui_look look=classic layout=classic
run new_starter_mesh name=stylised-head
key f
camera 0 0
click "Move##brush.move"
stroke 0.42 0.95 0.5 1.0
expect_value open_edges > 0
remember solid_volume v
remember triangles before
shot pulled
camera 0 70
shot pulled_below
camera 0 0

# Tool > Remesh > Voxel Remesh.
click "Remesh##tool.remesh"
click "Voxel Remesh##geometry.remesh"
wait_idle 120
expect_status Remeshed
expect_value open_edges == 0
expect_value solid_volume > $v*0.93
expect_value solid_volume < $v*1.07
shot voxel_remesh
camera 0 70
shot voxel_remesh_below
camera 0 0
key ctrl+z
expect_value triangles == $before

# Quick Remesh (Shift+R).
click "Quick Remesh##remesh.quick"
key shift+r
wait_idle 120
expect_status Quick Remesh: remeshed
expect_value open_edges == 0
expect_value solid_volume > $v*0.93
expect_value solid_volume < $v*1.07
shot quick_remesh
camera 0 70
shot quick_remesh_below
camera 0 0
key ctrl+z
expect_value triangles == $before
click "Quick Remesh##remesh.quick"
