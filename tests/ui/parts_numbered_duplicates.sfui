# Numbered duplicates (Discord ask): Duplicate names copies Head.01, Head.02, ... (the lowest free number; a copy of a copy
# counts on from the same name), never "Head copy copy".
run new_sphere subdivisions=3 ; part_rename to=Head
expect "Parts/Head"
click "Parts/Duplicate"
expect_value parts == 2
expect "Parts/Head.01"
click "Parts/Duplicate"
expect_value parts == 3
expect "Parts/Head.02"
expect_status Duplicated as Head.02
# The original again: the next free number.
click "Parts/Head"
click "Parts/Duplicate"
expect "Parts/Head.03"
expect_not "Parts/Head copy"
shot numbered
# A number freed by a delete is used again.
click "Parts/Head.02"
click "Parts/Delete..."
click "Delete Part?/Delete"
expect_not "Parts/Head.02"
click "Parts/Head"
key ctrl+shift+d
expect "Parts/Head.02"
expect_value parts == 4
shot refilled
