# A run of quick strokes keeps the edited part small (artist-qa 11-12 on 910d0951: after the 5th of 8 quick Clay strokes on a
# textured 5M mesh the WHOLE mesh drew in full, coarse again after the 6th). A stroke whose vertex left the position grid
# made a new grid and re-sent every vertex, and every cluster counted as edited, so all of them drew in full beside the
# coarse level. The coarse levels hold exact positions: only the clusters the stroke touched follow it.
# edited_clusters: the clusters drawn in full beside the coarse level (a stroke touches tens of the 600+).
run ui_look look=classic layout=classic
env SF_TRIANGLE_BUDGET 40000
env SF_STILL_FRAME_MS 0.001
run new_sphere subdivisions=8
camera -20 -10
key f
wait 1.0
run brush_set_alpha name=scales
click "Standard##brush.standard"
brush_size 260
stroke 0.05 0.25 0.95 0.25 0.8
stroke 0.05 0.45 0.95 0.45 0.8
stroke 0.05 0.65 0.95 0.65 0.8
stroke 0.05 0.85 0.95 0.85 0.8
run brush_set_alpha name=none
wait_idle 60
wait 1.0
expect_value triangles > 1000000
click "Clay##brush.clay"
brush_size 60
hover_window 0.97 0.5
wait 0.3
stroke 0.30 0.35 0.55 0.32 0.12
expect_value edited_clusters < 120
stroke 0.32 0.45 0.62 0.48 0.12
expect_value edited_clusters < 120
stroke 0.28 0.55 0.58 0.52 0.10
expect_value edited_clusters < 120
stroke 0.40 0.30 0.45 0.60 0.12
expect_value edited_clusters < 120
stroke 0.35 0.40 0.65 0.42 0.08
expect_value edited_clusters < 120
stroke 0.30 0.50 0.60 0.38 0.08
expect_value edited_clusters < 120
stroke 0.45 0.32 0.30 0.55 0.10
expect_value edited_clusters < 120
stroke 0.50 0.40 0.35 0.62 0.10
expect_value edited_clusters < 120
wait 0.1
wait 0.5
expect_value stroke_detail_switches == 0
