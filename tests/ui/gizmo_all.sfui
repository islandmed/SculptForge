# Transform gizmo, All mode (Shift+W; fenix on Discord's idea): move, rotate and scale handles at once. Every handle
# is reachable and lights up, each drag does what its single mode does (axis-locked moves, Shift snapping, the
# readout, one undo step), posing with a mask and a pivot at the joint, Alt+drag moving only the gizmo, the
# gizmo_mode command, and the handles at 100% and 200% UI scale on a posed arm.
run new_sphere subdivisions=5 ; transform scale=3,0.7,0.7 pivot=origin ; part_rename to=Arm
key f
orbit -70 -45
remember center_x cx0
remember center_y cy0
remember center_z cz0
remember size_y sy0

# Shift+W: All. Its button lights up beside Move, Scale and Rotate; Shift+W again goes back to Draw.
key shift+w
expect_value gizmo_mode == 4
expect "Gizmo/Apply"
expect_status All:
key shift+w
expect_value gizmo_mode == 0
click "All##tool.gizmo_all"
expect_value gizmo_mode == 4
shot all-mode

# Every handle has a spot where it is the one under the cursor (it lights up), numbered as gizmo_hover counts.
gizmo_hover move_x
expect_value gizmo_hover == 1
gizmo_hover plane_xz
expect_value gizmo_hover == 5
gizmo_hover move_view
expect_value gizmo_hover == 7
gizmo_hover rotate_y
expect_value gizmo_hover == 9
gizmo_hover rotate_view
expect_value gizmo_hover == 11
gizmo_hover scale_x
expect_value gizmo_hover == 12
shot all-hover-scale-box
gizmo_hover scale_uniform
expect_value gizmo_hover == 15
shot all-hover-scale-tab

# An arrow moves along its axis only, as one undo step; the gizmo goes back with it.
snapshot
gizmo_drag move_x 90 0
expect_value moved > 1000
expect_value center_y == $cy0
expect_value center_z == $cz0
expect_status Gizmo Move
expect_value pivot_x > 0.2
key ctrl+z
expect_value moved == 0
expect_value pivot_x < 0.001

# Shift snaps a move to the grid (0.2 for a model this size).
hold shift
gizmo_drag move_y 0 -70
hold none
expect_value center_y > 0.19
key ctrl+z

# A box stretches along its axis, the outer tabs scale evenly; the status repeats the readout.
gizmo_drag scale_y 0 -60
expect_value size_y > $sy0*1.2
remember size_x sx0
expect_value size_x == $sx0
expect_status Gizmo Scale Y 1
key ctrl+z
expect_value size_y == $sy0
gizmo_drag scale_uniform 50 -50
expect_value size_y > $sy0*1.2
key ctrl+z
expect_value size_y == $sy0

# The view ring turns in the view.
gizmo_drag rotate_view 0 -80
expect_value moved > 1000
expect_status Gizmo Rotate
key ctrl+z

# Alt+drag an arrow: only the gizmo moves.
hold alt
gizmo_drag move_x 80 0
hold none
expect_value moved == 0
expect_value pivot_x > 0.3
click "Reset##gizmo.reset_pivot"

# Pose the forearm in All mode: mask the upper arm, Alt+click the elbow, turn a ring, Shift for 15 degree steps.
run mask_rect x0=-1 y0=-1 x1=0 y1=1
wait 0.1
expect_value pivot_x > 1
hold alt
click_part Arm 0.5 0.5
hold none
expect_status Pivot on Arm
snapshot
hold shift
gizmo_drag rotate_z 0 -90 0.5 keep
shot all-posing-mid-drag
release
hold none
expect_status .0 deg
expect_value moved > 1000
expect_value moved_masked == 0
expect_status Gizmo Rotate
run mask_clear
wait 0.2
gizmo_hover rotate_z
expect_value gizmo_hover == 10
shot posed-100

# 200% UI scale: the same handles, twice the size, still apart.
ui_scale 200
wait 0.2
gizmo_hover scale_x
expect_value gizmo_hover == 12
gizmo_hover move_view
expect_value gizmo_hover == 7
gizmo_hover scale_uniform
expect_value gizmo_hover == 15
shot posed-200
ui_scale 100
wait 0.2

# Scripts and the console: gizmo_mode.
run gizmo_mode mode=move
expect_value gizmo_mode == 1
run gizmo_mode mode=all
expect_value gizmo_mode == 4
run gizmo_mode mode=draw
expect_value gizmo_mode == 0
expect_not "Gizmo/Apply"

# Ctrl held: the button explains itself; its key is bindable like the others.
hold ctrl
hover "All##tool.gizmo_all"
expect_help "at once"
hold none
expect_shortcut tool.gizmo_all Shift+W

