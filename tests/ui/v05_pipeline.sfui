# The v0.5 features together, as a game artist chains them: sculpt a high-poly, QRemesh a copy, divide it and
# project the detail back (ProjectAll), Auto UV the base, bake a normal map from the high-poly, and pose the
# retopologised mesh with the gizmo at a low subdivision level.
run new_sphere subdivisions=6 ; part_rename to=High
run stroke brush=Clay points="-0.5,0.2,2 0.5,0.25,2" radius=0.2 strength=1
run stroke brush=Crease points="-0.55,-0.35,2 0.55,-0.4,2" radius=0.12 strength=1
run part_duplicate ; part_rename to=Low

# Retopology: a light, mostly-quad mesh.
run qremesh target=1500
wait_idle 300
expect_value qremesh_running == 0
expect_value triangles < 6000
expect_value quad_percent > 80

# Subdivision levels, then project the high-poly's detail onto the top level.
run subdiv_divide ; subdiv_divide
expect_value sdiv == 3
expect_value sdiv_levels == 3
run part_visibility name=High visible=true
run project_all distance=0.1
wait_idle 120
run part_visibility name=High visible=false
shot projected

# Pose at the base level: the detail rides along when stepping back up.
run subdiv_level level=1
expect_value sdiv == 1
remember center_y base_y
run transform translate=0,0.25,0
expect_value center_y > $base_y
run subdiv_level level=3
expect_value center_y > $base_y
# Undo steps back through the level change, then the move.
key ctrl+z
expect_value sdiv == 1
key ctrl+z
expect_value center_y < 0.01

# Auto UV at the base and bake a normal map from the high-poly.
run subdiv_level level=1 ; uv_auto resolution=1024
wait_idle 300
run bake source=High maps=normal size=512 out=ui-shots/v05_pipeline/maps
wait_idle 300
expect_value baked_maps >= 1
shot baked
