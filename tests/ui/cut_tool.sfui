# Cut (#101, #91): the Cut shapes in the Ctrl+Shift brush picker, Tool > Cut's modes, one undo step per cut; and
# Duplicate Part's shortcut (Ctrl+Shift+D).
run new_sphere subdivisions=5
# Duplicate Part: Ctrl+Shift+D (then the copy goes again).
expect_value subtools == 1
key ctrl+shift+d
expect_value subtools == 2
run subtool_delete
expect_value subtools == 1
remember triangles full
hold ctrl+shift
click "##tile.brush"
wait 0.1
expect "Cut Rectangle##held.cut.rect"
hover "Cut Rectangle##held.cut.rect"
expect_help "rectangle"
shot cut-brush-picker
click "Cut Rectangle##held.cut.rect"
hold none
expect_value hide_shape == 5

# Away: a hole through the sphere (with X symmetry the rectangle mirrors onto itself).
hold ctrl+shift
drag_path 0.38 0.36 0.62 0.6 keep
wait 0.1
shot cut-rect-dragging
release
hold none
wait 0.2
expect_value hidden == 0
expect_value can_undo == 1
shot cut-rect-away
key ctrl+z
expect_value triangles == $full

# Tool > Cut: Add raises a rectangle, In cuts a pocket with a lasso.
click "Cut"
click "Add##cut.add"
shot cut-panel
hold ctrl+shift
drag_path 0.4 0.4 0.6 0.55
hold none
wait 0.2
expect_value can_undo == 1
shot cut-rect-add
key ctrl+z
click "In##cut.in"
click "Cut Lasso##cut.lasso"
expect_value hide_shape == 4
hold ctrl+shift
drag_path 0.4 0.4 0.6 0.42 0.55 0.6 0.42 0.58
hold none
wait 0.2
expect_value can_undo == 1
shot cut-lasso-in

# Back to Select Rectangle: Ctrl+Shift hides again.
click "Away##cut.away"
hold ctrl+shift
click "##tile.brush"
wait 0.1
click "Select Rectangle##held.select.rect"
hold none
expect_value hide_shape == 2

