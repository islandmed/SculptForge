# Cloth brush (docs/design/cloth.md, phase 1): picked from the shelf, a drag across the sphere moves the surface
# near the stroke as fabric (folds, nothing far away moves), undo puts it all back; Brush > Cloth's mode and fabric.
run ui_look look=classic layout=classic        # written for the Classic look and the classic palette bar and shelves
run new_sphere subdivisions=6
wait_idle 30
camera 0 0

click "Cloth##brush.cloth"
expect_value brush_type == 21
snapshot
stroke 0.42 0.5 0.6 0.5
expect_value moved > 500
expect_value cloth_region > 500
expect_value can_undo == 1
wait_idle 30
shot cloth_drag
key ctrl+z
expect_value moved == 0

# Brush > Cloth: mode and fabric, with help.
click "Brush##palette.brush"
click "Brush/##totray"
wait 0.3
click "Cloth##brush.cloth_options"
expect "##clothmode"
expect "##clothfabric"
expect "##clothreach"
hold ctrl
hover "##clothmode"
expect_help bunches
hover "##clothfabric"
expect_help Denim
hold none
expect_value cloth_mode == 0
expect_value cloth_fabric == 1
shot cloth_panel
