# ZBrush navigation: free rotation over the top, Shift snaps to an axis view, Alt-drag then release Alt
# zooms, Ctrl+right-drag zooms, Alt+right-drag pans.
run new_sphere subdivisions=4
input_style zbrush
expect_value camera_roll == 0

# Free rotation (the default) rolls right over the top: drag 400 px up/down = 183 degrees.
orbit 0 400
expect_value camera_up < -0.9
shot upside-down
key f

# Shift while rotating snaps to the nearest front / side / top view.
hold shift
orbit 61 -37
hold none
expect_value camera_aligned == 1
shot snapped

# Alt+drag on the background pans; let go of Alt mid-drag and the rest of the drag zooms.
remember camera_distance d0
remember camera_pan p0
hold alt
drag 0.12 0.3 0.12 0.7 0.6 release
expect_value camera_pan != $p0
# (the zoom part of that drag went down: in)
expect_value camera_distance < $d0

# Right-drag: Ctrl zooms, Alt pans. As in ZBrush, dragging up zooms out and dragging down zooms in.
remember camera_distance d1
hold ctrl
orbit 0 -120
hold none
expect_value camera_distance > $d1
remember camera_distance d2
hold ctrl
orbit 0 240
hold none
expect_value camera_distance < $d2
remember camera_pan p1
hold alt
orbit 80 0
hold none
expect_value camera_pan != $p1
