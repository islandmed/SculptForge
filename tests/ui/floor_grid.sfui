# Floor grid (#115): View > Display > Floor grid (also Tool > Display and the command palette) draws a faint grid on
# the ground plane through the world origin (y = 0), fading into the distance. Off by default; a preference.
run ui_look look=forge layout=sculptforge
run new_sphere subdivisions=4
camera 30 -20
wait 0.3
expect_value floor_grid == 0
remember drawn_triangles sphere_tris
shot off
expect_value floor_grid_drawn == 0

click "View##menu.view"
expect "Floor grid##render"
click "Floor grid##render"
expect_value floor_grid == 1
shot view-menu
key escape
wait 0.3
shot on
expect_value floor_grid_drawn == 1
# The grid adds none of the model's triangles (it draws one quad of its own).
expect_value drawn_triangles == $sphere_tris

# Seen from above and from far away: the grid steps up by ten, and fades out at the edges.
camera 30 -60
wait 0.3
shot above
camera_distance 40
wait 0.3
shot far
key f
wait 0.3
# From below the floor the grid draws over what is above it (a ceiling seen through), still faint.
camera 30 20
wait 0.3
shot below

# A plane on the floor itself stays in front of the grid.
run new_plane resolution=32
camera 20 -25
wait 0.3
shot plane

# HiDPI: the lines stay one pixel wide (they're drawn per pixel, not scaled).
run new_sphere subdivisions=4
camera 30 -20
ui_scale 200
wait 0.3
shot on-2x
ui_scale 100

# Kept after a restart; the command palette turns it off.
restart
expect_value floor_grid == 1
key f3
type "##Command palette" "floor grid"
key enter
expect_value floor_grid == 0
wait 0.3
shot palette-off
expect_value floor_grid_drawn == 0
restart
expect_value floor_grid == 0

# Tool > Display has the same switch.
run ui_look look=classic layout=classic
click "Tool##palette.tool"
click "Display##tool.display"
click "Floor grid##display"
expect_value floor_grid == 1
shot tool-display
