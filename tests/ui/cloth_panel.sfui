# Tool > Cloth: the Cloth brush settings and Drape in one section; "Cloth settings..." in Tool > Drape and in
# Brush > Cloth opens it. The controls are the same state as Tool > Drape and Brush > Cloth (a wind set there shows
# here, a mode set there shows here). The wind is set in Tool > Drape while it is the only section in the tray
# (the long tray with the Brush palette scrolls the sliders out of reach).
run ui_look look=classic layout=classic newer_rows=true   # Classic with Show newer menu rows: Tool > Cloth is a row added after 0.13.0
run new_sphere subdivisions=4
wait_idle 30
click "Tool##palette.tool"
click "Drape##tool.drape"
expect "##drapewind"
expect_not "##drapegusts"                 # (no wind yet: its heading, lift and gusts stay hidden)
drag_item "##drapewind" 120 0
wait_value drape_wind > 0 5
expect "##drapeheading"
expect "From view##drapewind"
expect "##drapelift"
drag_item "##drapegusts" 100 0
wait_value drape_gusts > 0 5
click "Cloth settings...##drape"
wait_idle 10
expect "Simulate##drape"
expect "##clothfabric"
expect "##drapegusts"                     # (the same wind, so the gusts show here too)
wait_idle 10
shot cloth_panel
# From the brush: the link opens the same section; the mode picked in Brush > Cloth is the panel's mode.
click "Cloth##brush.cloth"
click "Brush##palette.brush"
click "Brush/##totray"
wait 0.3
click "Cloth##brush.cloth_options"
expect "##clothmode"
click "Cloth settings...##brush"
wait_idle 10
expect "Simulate##drape"
click "##clothmode"
click "Grab##clothmode"
wait_value cloth_mode == 3 5
