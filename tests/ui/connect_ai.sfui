# Help > Connect an AI tool (PanelConnectAi.cpp): the in-app guide in three steps. 1. pick your tool: for this install,
# the live-mode server's exact command or settings (--mcp --attach, listed as sculptforge-live); 2. the live-mode
# switch, right there; 3. what happens next; example prompts with Copy. Only while AI features are on (Preferences > AI).
# UI tests never start a browser: no docs clicks.
run ui_look look=classic layout=classic
run new_sphere subdivisions=3
run ai_features on=true
click "Help##palette.help"
expect "Connect an AI tool...##help.connect_ai"
click "Connect an AI tool...##help.connect_ai"
expect_value connect_ai_open == 1
# Claude Code first.
expect_text "1. Pick your tool"
expect_text "claude mcp add --scope user sculptforge-live --"
expect_text "--mcp --attach"
expect_text "2. Let it work in this window"
expect_text "3. What happens next"
expect_text "Try asking"
shot connect_claude_code
click "Claude Desktop##ai_tool.claude_desktop"
expect_text "claude_desktop_config.json"
expect_text "sculptforge-live"
shot connect_claude_desktop
click "Cursor##ai_tool.cursor"
expect_text "mcp.json"
click "Other tools##ai_tool.other"
expect_text "codex mcp add sculptforge-live --"
shot connect_other
# Copy puts the exact text on the clipboard.
click "Copy##prompt0"
expect_status Copied to the clipboard
expect_clipboard "creature head"
click "Copy##0"
expect_clipboard "codex mcp add sculptforge-live"
# Step 2 is live mode's own switch: on here is on in Preferences > AI.
expect_value ai_link_state == 0
click "Let AI tools control this window##connect.ai_live"
expect_value ai_link_state == 1
expect_text "On: your AI tool can ask to connect."
click "Let AI tools control this window##connect.ai_live"
expect_value ai_link_state == 0
# AI off: the window closes and Help no longer offers it.
run ai_features on=false
expect_value connect_ai_open == 0
click "Help##palette.help"
expect_not "Connect an AI tool...##help.connect_ai"
key Escape
run ai_features on=true

# A studio's policy (core/ManagedPolicy.h): "live": "never" locks step 2 (the tool gets its own scene, no --attach);
# MCP off closes the guide and Help no longer offers it.
run ui_policy json="{\"format\":\"sculptforge-policy\",\"version\":1,\"organization\":\"Acme Animation\",\"mcp\":{\"live\":\"never\"}}"
click "Help##palette.help"
click "Connect an AI tool...##help.connect_ai"
expect_value connect_ai_open == 1
expect_value ai_link_state == 0
expect_text Managed by your studio
expect_text your studio doesn't let them control this window
shot connect-ai-managed
run ui_policy json="{\"format\":\"sculptforge-policy\",\"version\":1,\"mcp\":{\"enabled\":false}}"
expect_value connect_ai_open == 0
run ui_policy json=""
