# Preferences > AI in every language: Enable AI features, its description, the privacy line, live mode, the Hugging Face
# token and AI services & privacy are translated (they were shown in English before tr() reached them) and fit.
# One sub-palette open (the default): opening a section closes the others.
run ui_look look=classic layout=classic
run new_sphere subdivisions=2
click "Preferences##palette.preferences"
click "AI##preferences.ai"
expect "Enable AI features##prefs.ai"
expect "AI services & privacy##prefs.ai"
shot ai-prefs-en

click "Interface##preferences.interface"
click "Español##language.es"
click "AI##preferences.ai"
expect "Activar funciones de IA##prefs.ai"
expect "Servicios de IA y privacidad##prefs.ai"
expect_text "Tu arte nunca se sube"
shot ai-prefs-es

click "Interfaz##preferences.interface"
click "繁體中文##language.zh-TW"
click "AI##preferences.ai"
expect "啟用 AI 功能##prefs.ai"
expect "AI 服務與隱私##prefs.ai"
shot ai-prefs-zh-tw

click "界面##preferences.interface"
click "简体中文##language.zh-CN"
click "AI##preferences.ai"
expect "启用 AI 功能##prefs.ai"
expect "AI 服务与隐私##prefs.ai"
expect_text "你的作品绝不会被上传或用于训练"
shot ai-prefs-zh-cn

click "界面##preferences.interface"
click "English##language.en"
expect "Interface##preferences.interface"
key escape
