# Sculpt layers on subdivision levels (3D Layers): a layer recorded at the top of a divided box survives
# Lower Level / Higher Level, its weight slider works at every level, Divide carries it to a new level, and undo
# steps back through it all.
run new_sphere subdivisions=1
run part_append type=cube name=Box
run part_delete index=0
orbit 140 -70
key f
click "Geometry##tool.geometry"
click "Geometry/Reconstruct Subdiv"
click "Geometry/Reconstruct Subdiv"
click "Geometry/Reconstruct Subdiv"
click "Geometry/Reconstruct Subdiv"
click "Geometry/Delete Higher"
click "Delete Levels/Delete Higher Levels"
expect_value triangles == 108
key ctrl+d
key ctrl+d
key ctrl+d
expect_value sdiv_levels == 4
expect_value sdiv == 4

# Record a layer at the top: a new layer, then strokes into it.
click "Layers##tool.layers"
type "Layers/##newlayer" Smile
click "Layers/+ Add"
expect_value layers == 1
expect_status "Smile"
key b
key s
key t
snapshot
stroke 0.3 0.45 0.7 0.5
stroke 0.35 0.6 0.65 0.62
expect_value moved > 50
remember moved_max layer_height

# Its eye takes it away and brings it back.
click "Layers/##eye"
expect_value moved_max < 0.000001
click "Layers/##eye"
expect_value moved_max >= $layer_height*0.999

# Down to SDiv 1 and back up: still there, exactly.
key shift+d
key shift+d
key shift+d
expect_value sdiv == 1
expect_value layers == 1
shot layer-at-sdiv1
# Off at the lowest level: off at the top too.
click "Layers/##eye"
key d
key d
key d
expect_value sdiv == 4
expect_value moved_max < 0.000001
click "Layers/##eye"
expect_value moved_max >= $layer_height*0.999
shot layer-at-top

# Divide with the layer: the new level has it too.
key ctrl+d
expect_value sdiv_levels == 5
expect_value layers == 1
key shift+d
expect_value sdiv == 4
expect_value moved_max >= $layer_height*0.999

# Undo walks back through the level steps and the division.
key ctrl+z
expect_value sdiv == 5
key ctrl+z
expect_value sdiv_levels == 4
expect_value layers == 1

# Ctrl-hover help on the Layers panel.
hold ctrl
hover "Layers/Smile"
expect_help "every level"
hover "Layers/##weight"
expect_help "every subdivision level"
hold none
