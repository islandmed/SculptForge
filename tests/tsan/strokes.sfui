# ThreadSanitizer smoke (tools/test/tsan.sh): strokes, a mask stroke and full uploads on a mesh big enough that the
# vertex uploads run on several threads. Renderer::uploadVertices and prepareStrokeUpload wrote a vertex's cavity
# bits from every copy of it at once (11-05).
run new_sphere subdivisions=6
key f
stroke 0.2 0.5 0.8 0.5
stroke 0.3 0.3 0.7 0.7
hold ctrl
stroke 0.3 0.6 0.7 0.4
hold none
stroke 0.5 0.2 0.5 0.8
run subdivide
stroke 0.2 0.4 0.8 0.6
wait 0.5
