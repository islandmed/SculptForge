# e2e: Voxel Remesh at about 2M triangles. An artist remeshes a sculpt to 512 voxels, keeps sculpting on the dense
# mesh, and undoes: the remesh is one undo step, every stroke is one, the mesh stays valid and no frame stalls.
# Quick Remesh (N held + drag on the background, Shift+R) is the other way in; it remeshes the same way, one undo step.
# The frame cap is for the floor tier (time_limit_scale: 4 on CI or in a parallel ctest).
run new_sphere subdivisions=5
camera 0 0
click "Remesh##tool.remesh"
hold ctrl
click "##voxres"
hold none
type "Resolution##voxrestype" 512
key enter
expect_value voxel_resolution == 512
remember triangles before
remember time_limit_scale scale

# Remesh: a background job, watertight, 1M-3M triangles, one undo step.
click "Voxel Remesh##geometry.remesh"
wait_idle 240
expect_status Remeshed
expect_value triangles > 1000000
expect_value triangles < 3000000
expect_value open_edges == 0
expect_mesh_valid
remember triangles dense
expect_value can_undo == 1

# Strokes on the dense mesh: sculpting, smoothing, a mask; no stall longer than the cap, no new triangles.
remember longest_frame_ms ignored      # (the read resets it: the remesh's own frames don't count)
click "Clay##brush.clay"
stroke 0.3 0.5 0.7 0.5
expect_value longest_frame_ms < $scale*4000   # (the first stroke builds the dense mesh's acceleration data: 1.3 s on an M1 Pro)
action brush.smooth
stroke 0.3 0.45 0.7 0.45
expect_value longest_frame_ms < $scale*500
expect_value triangles == $dense
expect_value open_edges == 0
expect_mesh_valid

# Undo walks back: two strokes, then the remesh itself.
key ctrl+z
key ctrl+z
expect_value triangles == $dense
key ctrl+z
expect_value triangles == $before
expect_value can_undo == 0
key ctrl+shift+z
expect_value triangles == $dense

# Quick Remesh: N held + drag on the background, one undo step too.
key ctrl+z
click "Quick Remesh##remesh.quick"
expect_value quick_remesh == 1
key_down n
drag_path 0.03 0.03 0.1 0.05
key_up n
wait_idle 240
expect_status Quick Remesh: remeshed
expect_value triangles > 1000000
expect_mesh_valid
key ctrl+z
expect_value triangles == $before
