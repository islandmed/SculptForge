# Close-up: Voxel Remesh at high resolution (600) on a sculpted curved form (tools/qa/closeup.py runs it; not a ctest
# case). The new surface must sit on the old one (no shrink, no lumps), keep the crease and the clay edges crisp enough,
# and add no spikes. Then the memory dialogs (high resolution, may use swap) at 100% and 200% UI scale.
run ui_look look=classic layout=classic
run new_sphere subdivisions=6
camera 0 0
key f
wait_idle 30
click "Clay##brush.clay"
brush_size 60
drag_path 0.30 0.35 0.45 0.30 0.60 0.32 0.70 0.38 S=0.8
pen_stroke 0.32 0.62 0.68 0.64 0.2 1.0
click "Crease##brush.crease"
brush_size 25
drag_path 0.35 0.48 0.50 0.45 0.65 0.48 S=0.6
click "Inflate##brush.inflate"
brush_size 50
stroke 0.55 0.75 0.60 0.78
wait_idle 30
print triangles
run save_obj path=cf_00.obj
hover_window 0.97 0.5
zoom 2
wait_idle 30
shot r00-before-close
camera 0 0
key f
wait_idle 30

click "Remesh##tool.remesh"
hold ctrl
click "##voxres"
hold none
type "Resolution##voxrestype" 600
key enter
click "Voxel Remesh##geometry.remesh"
wait 0.3
shot r01-highres-confirm
ui_scale 200
wait_idle 30
wait 0.5
shot r01-highres-confirm-200
ui_scale 100
wait_idle 30
click "Remesh##voxelhighres"
wait_idle 300
print triangles
print longest_frame_ms
run save_obj path=cf_01.obj
#step 00 01 remesh voxel 600
hover_window 0.97 0.5
wait_idle 30
shot r02-after
zoom 2
wait_idle 30
shot r03-after-close
camera 55 5
wait_idle 30
shot r04-after-graze-side
camera 0 60
wait_idle 30
shot r05-after-graze-top
camera 0 0
key f
key ctrl+z
wait_idle 30

# The swap dialog (more than is free, within RAM + swap), at 100% and 200%; Cancel leaves the Part as it is.
env SF_AVAILABLE_MEMORY_MB 10
env SF_TOTAL_MEMORY_MB 4096
env SF_SWAP_MAX_MB 2048
click "Voxel Remesh##geometry.remesh"
wait 0.3
shot r10-swap-dialog
ui_scale 200
wait_idle 30
wait 0.5
shot r10-swap-dialog-200
ui_scale 100
wait_idle 30
click "Cancel##voxelswap"
env SF_AVAILABLE_MEMORY_MB 0
env SF_TOTAL_MEMORY_MB 0
env SF_SWAP_MAX_MB auto
