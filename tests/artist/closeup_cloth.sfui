# Close-up: the Cloth brush under X symmetry on the Full Body (#200): both sides must move alike (tools/qa/mirror_check.py),
# no folds or specks, no ridge along the mirror plane; then one stroke with symmetry off (closeup.py judges each step).
run ui_look look=classic layout=classic
run new_starter_mesh name=full-body
wait_idle 30
camera 0 0
look 0 125 0
zoom 2.6
click "Cloth##brush.cloth"
print symmetry_x
wait_idle 30
run save_obj path=cf_00.obj
brush_size 60
pen_stroke 0.20 0.17 0.32 0.21 0.2 1.0
stroke 0.22 0.24 0.33 0.27
pen_stroke 0.26 0.14 0.28 0.30 1.0 0.3
wait_idle 30
run save_obj path=cf_01.obj
#step 00 01 any Cloth, X symmetry, away from the plane
hover_window 0.97 0.5
shot k01-sides
brush_size 50
pen_stroke 0.44 0.20 0.56 0.22 0.3 1.0
stroke 0.47 0.15 0.53 0.30
stroke 0.40 0.26 0.60 0.26
wait_idle 30
run save_obj path=cf_02.obj
#step 01 02 any Cloth, X symmetry, near and across the plane
shot k02-center
click "X##transform.symmetry_x"
print symmetry_x
pen_stroke 0.20 0.40 0.34 0.42 0.3 1.0
wait_idle 30
run save_obj path=cf_03.obj
#step 02 03 any Cloth, symmetry off
shot k03-nosym
click "X##transform.symmetry_x"
look 0 130 12
zoom 2.5
wait_idle 30
shot k10-center-close
look 24 130 12
wait_idle 30
shot k11-close-a
look -24 130 12
wait_idle 30
shot k12-close-b
