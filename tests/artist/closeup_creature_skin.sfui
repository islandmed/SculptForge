# Creature Skin close-ups (gh#228; not a ctest case: artist-qa and the branch's before/after shots run it): the lion head
# at micro level 3, turned so the middle of the view is on its cheek. For each pair, one stroke of the classic brush
# through the middle (before), undo, the same stroke with the Creature Skin brush (after); a wide shot and a close-up.
# Then each of the other pack brushes once on its own. Every stroke must move the micro level.
run ui_look look=classic layout=classic
run open path=$SCRIPT_DIR/../../assets/demo/lion-head.glb
run micro_divide level=3
wait_idle 300
camera 28 -8
key f
wait_idle 30
print triangles
zoom 2.5
wait_idle 30
hover_window 0.97 0.5
shot cs00-start

# Skin Pores (before) / Pores Fine (after)
run brush_use name="Skin Pores"
brush_size 70
snapshot
drag_path 0.44 0.50 0.50 0.50 0.56 0.50 S=1.2
wait_idle 60
print longest_frame_ms
expect_value micro_moved > 0
hover_window 0.97 0.5
shot cs01-pores-before
zoom 3
wait_idle 30
shot cs01-pores-before-close
zoom 0.3333333
wait_idle 30
key ctrl+z
wait_idle 30
run brush_use name="Pores Fine"
brush_size 70
snapshot
drag_path 0.44 0.50 0.50 0.50 0.56 0.50 S=1.2
wait_idle 60
print longest_frame_ms
expect_value micro_moved > 0
hover_window 0.97 0.5
shot cs01-pores-after
zoom 3
wait_idle 30
shot cs01-pores-after-close
zoom 0.3333333
wait_idle 30
key ctrl+z
wait_idle 30

