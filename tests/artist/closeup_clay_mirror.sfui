# Close-up: Clay under X symmetry with strokes ACROSS the mirror plane (tools/qa/closeup.py judges each step;
# tools/qa/mirror_check.py compares each side with its mirror). The two copies overlap at the seam: no ring, crease or
# step there, and both sides alike.
run ui_look look=classic layout=classic
key ctrl+n
wait 0.2
key ctrl+d
key ctrl+d
wait_idle 120
camera 0 0
key f
wait_idle 30
print symmetry_x
run save_obj path=cf_00.obj
click "Clay##brush.clay"
# 1 a big light stroke straight across the seam
brush_size 120
pen_stroke 0.28 0.40 0.72 0.40 0.25 0.3
wait_idle 30
run save_obj path=cf_01.obj
#step 00 01 build big light across
shot c01-big-light
# 2 a long pull that crosses the seam twice
brush_size 80
drag_path 0.30 0.62 0.42 0.52 0.55 0.66 0.66 0.56 0.70 0.70 S=1.5
wait_idle 30
run save_obj path=cf_02.obj
#step 01 02 build long pull
shot c02-long
# 3 a steep stroke along the seam, heavy
brush_size 60
pen_stroke 0.49 0.20 0.51 0.80 0.9 1.0
wait_idle 30
run save_obj path=cf_03.obj
#step 02 03 build along seam
shot c03-along
# 4 a stroke that ends right on the seam, and one that starts there
brush_size 50
stroke 0.30 0.28 0.50 0.30
stroke 0.50 0.75 0.68 0.82
wait_idle 30
run save_obj path=cf_04.obj
#step 03 04 build to/from seam
shot c04-seam-ends
# 5 the big light stroke stacked twice more
brush_size 120
pen_stroke 0.28 0.40 0.72 0.40 0.25 0.3
pen_stroke 0.28 0.40 0.72 0.40 0.25 0.3
wait_idle 30
run save_obj path=cf_05.obj
#step 04 05 build stacked x2
shot c05-stacked
hover_window 0.97 0.5
zoom 2.5
wait_idle 30
shot c10-close-front
camera 0 60
wait_idle 30
shot c11-close-graze-top
camera 0 -50
wait_idle 30
shot c12-close-graze-low
camera 40 5
wait_idle 30
shot c13-close-graze-side

# The head: cheek mass and a brow across the middle.
run new_starter_mesh name=human-head levels=3
camera 0 0
key f
wait_idle 30
run save_obj path=cf_20.obj
click "Clay##brush.clay"
brush_size 45
stroke 0.36 0.52 0.40 0.62
pen_stroke 0.34 0.58 0.42 0.70 0.3 1.0
brush_size 55
pen_stroke 0.34 0.36 0.66 0.36 0.3 0.6
stroke 0.40 0.33 0.60 0.33
wait_idle 30
run save_obj path=cf_21.obj
#step 20 21 any face cheek + brow across
hover_window 0.97 0.5
shot c20-face
camera 0 30
zoom 2
wait_idle 30
shot c21-face-brow-top
camera 40 5
wait_idle 30
shot c22-face-graze
